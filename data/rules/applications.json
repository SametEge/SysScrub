{
  "version": 1,
  "rules": [
    {
      "id": "app.discord.cache",
      "category": "Applications",
      "group": "Discord",
      "name": { "tr": "Discord önbelleği", "en": "Discord cache" },
      "explanation": {
        "tr": "Discord'un indirdiği resim, emoji ve ek dosyaları. Silinince oturumun kapanmaz.",
        "en": "Images, emoji and attachments Discord downloaded. Cleaning does not sign you out."
      },
      "risk": "safe",
      "blockingProcesses": ["Discord", "DiscordPTB", "DiscordCanary"],
      "roots": [
        { "base": "RoamingAppData", "path": "discord/Cache" },
        { "base": "RoamingAppData", "path": "discord/Code Cache" },
        { "base": "RoamingAppData", "path": "discord/GPUCache" },
        { "base": "RoamingAppData", "path": "discordptb/Cache" },
        { "base": "RoamingAppData", "path": "discordcanary/Cache" }
      ],
      "deleteMode": "permanent"
    },
    {
      "id": "app.spotify.cache",
      "category": "Applications",
      "group": "Spotify",
      "name": { "tr": "Spotify önbelleği", "en": "Spotify cache" },
      "explanation": {
        "tr": "Çevrimdışı dinleme için indirilen parçalar hariç, geçici akış verisi. Çevrimdışı kaydettiğin listeler etkilenmez.",
        "en": "Temporary streaming data, excluding tracks downloaded for offline listening. Your offline playlists are untouched."
      },
      "risk": "safe",
      "blockingProcesses": ["Spotify"],
      "roots": [{ "base": "LocalAppData", "path": "Spotify/Data" }],
      "deleteMode": "permanent"
    },
    {
      "id": "app.teams.cache",
      "category": "Applications",
      "group": "Microsoft Teams",
      "name": { "tr": "Teams önbelleği", "en": "Teams cache" },
      "explanation": {
        "tr": "Teams'in sakladığı geçici veri. Teams sık sık bozulan önbellek yüzünden takılır; temizlemek çoğu sorunu çözer.",
        "en": "Temporary data Teams keeps. Teams often misbehaves due to a corrupted cache, and clearing it fixes most issues."
      },
      "risk": "safe",
      "blockingProcesses": ["Teams", "ms-teams"],
      "roots": [
        { "base": "RoamingAppData", "path": "Microsoft/Teams/Cache" },
        { "base": "RoamingAppData", "path": "Microsoft/Teams/Code Cache" },
        { "base": "RoamingAppData", "path": "Microsoft/Teams/GPUCache" },
        { "base": "RoamingAppData", "path": "Microsoft/Teams/Service Worker/CacheStorage" },
        { "base": "LocalAppData", "path": "Packages/MSTeams_8wekyb3d8bbwe/LocalCache/Microsoft/MSTeams/Logs" }
      ],
      "deleteMode": "permanent"
    },
    {
      "id": "app.slack.cache",
      "category": "Applications",
      "group": "Slack",
      "name": { "tr": "Slack önbelleği", "en": "Slack cache" },
      "explanation": {
        "tr": "Slack'in indirdiği geçici dosyalar ve günlükler. Oturumun etkilenmez.",
        "en": "Temporary files and logs Slack downloaded. Your session is not affected."
      },
      "risk": "safe",
      "blockingProcesses": ["slack"],
      "roots": [
        { "base": "RoamingAppData", "path": "Slack/Cache" },
        { "base": "RoamingAppData", "path": "Slack/Code Cache" },
        { "base": "RoamingAppData", "path": "Slack/GPUCache" },
        { "base": "RoamingAppData", "path": "Slack/logs" }
      ],
      "deleteMode": "permanent"
    },
    {
      "id": "app.zoom.cache",
      "category": "Applications",
      "group": "Zoom",
      "name": { "tr": "Zoom önbelleği ve günlükleri", "en": "Zoom cache and logs" },
      "explanation": {
        "tr": "Zoom'un geçici dosyaları ve günlükleri. Kayıtlarına dokunulmaz.",
        "en": "Zoom temporary files and logs. Your recordings are untouched."
      },
      "risk": "safe",
      "blockingProcesses": ["Zoom"],
      "roots": [
        { "base": "RoamingAppData", "path": "Zoom/logs" },
        { "base": "RoamingAppData", "path": "Zoom/data/Cache" }
      ],
      "deleteMode": "permanent"
    },
    {
      "id": "app.adobe.mediacache",
      "category": "Applications",
      "group": "Adobe",
      "name": { "tr": "Adobe medya önbelleği", "en": "Adobe media cache" },
      "explanation": {
        "tr": "Premiere ve After Effects'in ses/video için ürettiği ara dosyalar. Onlarca gigabayta ulaşabilir; projeler açıldığında yeniden üretilir.",
        "en": "Intermediate audio/video files generated by Premiere and After Effects. Can reach tens of gigabytes and is regenerated when projects open."
      },
      "risk": "safe",
      "blockingProcesses": ["Adobe Premiere Pro", "AfterFX"],
      "roots": [
        { "base": "RoamingAppData", "path": "Adobe/Common/Media Cache" },
        { "base": "RoamingAppData", "path": "Adobe/Common/Media Cache Files" },
        { "base": "RoamingAppData", "path": "Adobe/Common/Peak Files" }
      ],
      "deleteMode": "permanent"
    },
    {
      "id": "app.office.cache",
      "category": "Applications",
      "group": "Microsoft Office",
      "name": { "tr": "Office belge önbelleği", "en": "Office document cache" },
      "explanation": {
        "tr": "Office'in bulut belgeleri için tuttuğu yerel kopyalar. Senkronize edilmemiş değişiklik varsa kaybolabilir; Office kapalıyken temizle.",
        "en": "Local copies Office keeps for cloud documents. Unsynced changes could be lost, so clean this with Office closed."
      },
      "risk": "caution",
      "defaultEnabled": false,
      "blockingProcesses": ["WINWORD", "EXCEL", "POWERPNT", "OUTLOOK"],
      "roots": [
        { "base": "LocalAppData", "path": "Microsoft/Office/16.0/OfficeFileCache" }
      ],
      "deleteMode": "quarantine"
    },
    {
      "id": "app.vscode.cache",
      "category": "Applications",
      "group": "Kod düzenleyiciler",
      "name": { "tr": "VS Code / Cursor önbelleği", "en": "VS Code / Cursor cache" },
      "explanation": {
        "tr": "Düzenleyicinin geçici verisi ve günlükleri. Ayarların, eklentilerin ve açık dosyaların etkilenmez.",
        "en": "Editor temporary data and logs. Your settings, extensions and open files are untouched."
      },
      "risk": "safe",
      "blockingProcesses": ["Code", "Cursor"],
      "roots": [
        { "base": "RoamingAppData", "path": "Code/Cache" },
        { "base": "RoamingAppData", "path": "Code/CachedData" },
        { "base": "RoamingAppData", "path": "Code/Code Cache" },
        { "base": "RoamingAppData", "path": "Code/GPUCache" },
        { "base": "RoamingAppData", "path": "Code/logs" },
        { "base": "RoamingAppData", "path": "Cursor/Cache" },
        { "base": "RoamingAppData", "path": "Cursor/CachedData" },
        { "base": "RoamingAppData", "path": "Cursor/logs" }
      ],
      "minAgeDays": 3,
      "deleteMode": "permanent"
    },
    {
      "id": "app.gpu.installer.leftovers",
      "category": "Applications",
      "group": "Sürücü kurulum artıkları",
      "name": { "tr": "Ekran kartı kurulum artıkları", "en": "GPU installer leftovers" },
      "explanation": {
        "tr": "NVIDIA ve AMD sürücü kurulumlarının diskin köküne çıkardığı paketler. Kurulum bittikten sonra gereksizler, birkaç gigabayt tutabilirler.",
        "en": "Packages NVIDIA and AMD driver installers extract to the drive root. Useless once installation finished and can take several gigabytes."
      },
      "risk": "safe",
      "requiresAdmin": true,
      "roots": [
        { "base": "SystemDrive", "path": "NVIDIA" },
        { "base": "SystemDrive", "path": "AMD" },
        { "base": "SystemDrive", "path": "Intel/Logs" },
        { "base": "ProgramData", "path": "NVIDIA Corporation/Downloader" }
      ],
      "minAgeDays": 7,
      "deleteMode": "permanent"
    }
  ]
}

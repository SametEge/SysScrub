<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Grafit & Sinyal — açık tema. Tokens.Dark.xaml ile birebir aynı anahtar kümesi.

        Turuncu beyaz zeminde kontrast sorunu yaratır: bu yüzden açık temada vurgu dolgusu
        canlı kalır ama üzerine BEYAZ değil koyu metin gelir (SsOnAccent). Bağlantı gibi
        vurgu renginde metin gerektiğinde ayrı ve daha koyu bir ton kullanılır (SsAccentText).
    -->

    <!-- ==================== Zemin ve yüzeyler ==================== -->
    <Color x:Key="SsGroundColor">#F3F5F7</Color>
    <Color x:Key="SsSurfaceColor">#FFFFFF</Color>
    <Color x:Key="SsSurfaceRaisedColor">#EDF0F3</Color>
    <Color x:Key="SsSurfaceHoverColor">#E4E8ED</Color>
    <Color x:Key="SsBorderColor">#DCE1E7</Color>
    <Color x:Key="SsBorderStrongColor">#BFC7D0</Color>

    <SolidColorBrush x:Key="SsGround" Color="{StaticResource SsGroundColor}" />
    <SolidColorBrush x:Key="SsSurface" Color="{StaticResource SsSurfaceColor}" />
    <SolidColorBrush x:Key="SsSurfaceRaised" Color="{StaticResource SsSurfaceRaisedColor}" />
    <SolidColorBrush x:Key="SsSurfaceHover" Color="{StaticResource SsSurfaceHoverColor}" />
    <SolidColorBrush x:Key="SsBorder" Color="{StaticResource SsBorderColor}" />
    <SolidColorBrush x:Key="SsBorderStrong" Color="{StaticResource SsBorderStrongColor}" />

    <SolidColorBrush x:Key="SsSurfaceTranslucent" Color="#D6FFFFFF" />
    <SolidColorBrush x:Key="SsScrim" Color="#59000000" />

    <!-- ==================== Metin ==================== -->
    <Color x:Key="SsTextColor">#14171C</Color>
    <Color x:Key="SsTextSecondaryColor">#5A6472</Color>
    <Color x:Key="SsTextDisabledColor">#98A1AD</Color>

    <SolidColorBrush x:Key="SsText" Color="{StaticResource SsTextColor}" />
    <SolidColorBrush x:Key="SsTextSecondary" Color="{StaticResource SsTextSecondaryColor}" />
    <SolidColorBrush x:Key="SsTextDisabled" Color="{StaticResource SsTextDisabledColor}" />

    <!-- ==================== Vurgu — yalnızca etkileşimli öğeler ==================== -->
    <Color x:Key="SsAccentColor">#EE5F1F</Color>
    <Color x:Key="SsAccentHoverColor">#FF7434</Color>
    <Color x:Key="SsAccentPressedColor">#D24F13</Color>
    <Color x:Key="SsOnAccentColor">#1A1207</Color>

    <SolidColorBrush x:Key="SsAccent" Color="{StaticResource SsAccentColor}" />
    <SolidColorBrush x:Key="SsAccentHover" Color="{StaticResource SsAccentHoverColor}" />
    <SolidColorBrush x:Key="SsAccentPressed" Color="{StaticResource SsAccentPressedColor}" />
    <SolidColorBrush x:Key="SsAccentTint" Color="#22EE5F1F" />
    <SolidColorBrush x:Key="SsOnAccent" Color="{StaticResource SsOnAccentColor}" />
    <SolidColorBrush x:Key="SsAccentText" Color="#B8420C" />

    <SolidColorBrush x:Key="SsSand" Color="#8A6E45" />

    <LinearGradientBrush x:Key="SsAccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#FF7434" />
        <GradientStop Offset="1" Color="#E05012" />
    </LinearGradientBrush>

    <!-- ==================== Durum renkleri — yalnızca göstergeler ==================== -->
    <Color x:Key="SsGoodColor">#2E9E4C</Color>
    <Color x:Key="SsCautionColor">#B07A08</Color>
    <Color x:Key="SsDangerColor">#C93A3F</Color>
    <Color x:Key="SsInfoColor">#1F7FBF</Color>

    <SolidColorBrush x:Key="SsGood" Color="{StaticResource SsGoodColor}" />
    <SolidColorBrush x:Key="SsCaution" Color="{StaticResource SsCautionColor}" />
    <SolidColorBrush x:Key="SsDanger" Color="{StaticResource SsDangerColor}" />
    <SolidColorBrush x:Key="SsInfo" Color="{StaticResource SsInfoColor}" />

    <SolidColorBrush x:Key="SsGoodTint" Color="#1F2E9E4C" />
    <SolidColorBrush x:Key="SsCautionTint" Color="#1FB07A08" />
    <SolidColorBrush x:Key="SsDangerTint" Color="#1FC93A3F" />
    <SolidColorBrush x:Key="SsInfoTint" Color="#1F1F7FBF" />

    <!-- ==================== WPF-UI kaynaklarının üzerine yazımı ==================== -->
    <Color x:Key="ApplicationBackgroundColor">#F3F5F7</Color>
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#F3F5F7" />

    <Color x:Key="SolidBackgroundFillColorBase">#F3F5F7</Color>
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#F3F5F7" />
    <Color x:Key="SolidBackgroundFillColorBaseAlt">#FFFFFF</Color>
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseAltBrush" Color="#FFFFFF" />
    <Color x:Key="SolidBackgroundFillColorSecondary">#FFFFFF</Color>
    <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="#FFFFFF" />
    <Color x:Key="SolidBackgroundFillColorTertiary">#EDF0F3</Color>
    <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="#EDF0F3" />
    <Color x:Key="SolidBackgroundFillColorQuarternary">#E4E8ED</Color>
    <SolidColorBrush x:Key="SolidBackgroundFillColorQuarternaryBrush" Color="#E4E8ED" />

    <Color x:Key="CardBackgroundFillColorDefault">#FFFFFF</Color>
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FFFFFF" />
    <Color x:Key="CardBackgroundFillColorSecondary">#EDF0F3</Color>
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#EDF0F3" />
    <Color x:Key="CardStrokeColorDefault">#DCE1E7</Color>
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#DCE1E7" />
    <Color x:Key="CardStrokeColorDefaultSolid">#DCE1E7</Color>
    <SolidColorBrush x:Key="CardStrokeColorDefaultSolidBrush" Color="#DCE1E7" />

    <Color x:Key="ControlFillColorDefault">#FFFFFF</Color>
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#FFFFFF" />
    <Color x:Key="ControlFillColorSecondary">#EDF0F3</Color>
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#EDF0F3" />
    <Color x:Key="ControlFillColorTertiary">#E4E8ED</Color>
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#E4E8ED" />

    <Color x:Key="ControlStrokeColorDefault">#DCE1E7</Color>
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#DCE1E7" />
    <Color x:Key="ControlStrokeColorSecondary">#BFC7D0</Color>
    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#BFC7D0" />

    <Color x:Key="TextFillColorPrimary">#14171C</Color>
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#14171C" />
    <Color x:Key="TextFillColorSecondary">#5A6472</Color>
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#5A6472" />
    <Color x:Key="TextFillColorTertiary">#78828F</Color>
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#78828F" />
    <Color x:Key="TextFillColorDisabled">#98A1AD</Color>
    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#98A1AD" />

    <Color x:Key="TextOnAccentFillColorPrimary">#1A1207</Color>
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#1A1207" />

    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#EE5F1F" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#FF7434" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#D24F13" />
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#B8420C" />

    <Color x:Key="DividerStrokeColorDefault">#DCE1E7</Color>
    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#DCE1E7" />

    <Color x:Key="FocusStrokeColorOuter">#B8420C</Color>
    <SolidColorBrush x:Key="FocusStrokeColorOuterBrush" Color="#B8420C" />

    <Color x:Key="LayerFillColorDefault">#FFFFFF</Color>
    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#FFFFFF" />
    <Color x:Key="LayerFillColorAlt">#EDF0F3</Color>
    <SolidColorBrush x:Key="LayerFillColorAltBrush" Color="#EDF0F3" />

    <Color x:Key="SubtleFillColorSecondary">#E4E8ED</Color>
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#E4E8ED" />
    <Color x:Key="SubtleFillColorTertiary">#EDF0F3</Color>
    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#EDF0F3" />

    <Color x:Key="SystemFillColorSuccess">#2E9E4C</Color>
    <SolidColorBrush x:Key="SystemFillColorSuccessBrush" Color="#2E9E4C" />
    <Color x:Key="SystemFillColorSuccessBackground">#E8F5EC</Color>
    <SolidColorBrush x:Key="SystemFillColorSuccessBackgroundBrush" Color="#E8F5EC" />
    <Color x:Key="SystemFillColorCaution">#B07A08</Color>
    <SolidColorBrush x:Key="SystemFillColorCautionBrush" Color="#B07A08" />
    <Color x:Key="SystemFillColorCautionBackground">#FBF2DE</Color>
    <SolidColorBrush x:Key="SystemFillColorCautionBackgroundBrush" Color="#FBF2DE" />
    <Color x:Key="SystemFillColorCritical">#C93A3F</Color>
    <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="#C93A3F" />
    <Color x:Key="SystemFillColorCriticalBackground">#FAE9E9</Color>
    <SolidColorBrush x:Key="SystemFillColorCriticalBackgroundBrush" Color="#FAE9E9" />
    <Color x:Key="SystemFillColorAttention">#1F7FBF</Color>
    <SolidColorBrush x:Key="SystemFillColorAttentionBrush" Color="#1F7FBF" />
    <Color x:Key="SystemFillColorAttentionBackground">#E6F1F9</Color>
    <SolidColorBrush x:Key="SystemFillColorAttentionBackgroundBrush" Color="#E6F1F9" />

</ResourceDictionary>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        4px temel ızgara. Her boşluk ve yarıçap buradan gelir; ekranlarda serbest sayı kullanılmaz.
        Böylece sonradan eklenen bir sayfa da aynı ritmi tutar.
    -->

    <!-- ==================== Boşluk ==================== -->
    <sys:Double x:Key="SsSpace1">4</sys:Double>
    <sys:Double x:Key="SsSpace2">8</sys:Double>
    <sys:Double x:Key="SsSpace3">12</sys:Double>
    <sys:Double x:Key="SsSpace4">16</sys:Double>
    <sys:Double x:Key="SsSpace5">24</sys:Double>
    <sys:Double x:Key="SsSpace6">32</sys:Double>
    <sys:Double x:Key="SsSpace7">48</sys:Double>

    <Thickness x:Key="SsPagePadding">32,24,32,32</Thickness>
    <Thickness x:Key="SsCardPadding">20</Thickness>
    <Thickness x:Key="SsCardPaddingCompact">16</Thickness>

    <!-- ==================== Köşe yarıçapı ==================== -->
    <CornerRadius x:Key="SsRadiusSmall">6</CornerRadius>
    <CornerRadius x:Key="SsRadiusControl">8</CornerRadius>
    <CornerRadius x:Key="SsRadiusCard">12</CornerRadius>
    <CornerRadius x:Key="SsRadiusPanel">16</CornerRadius>
    <CornerRadius x:Key="SsRadiusPill">999</CornerRadius>

    <!-- ==================== Ölçüler ==================== -->
    <sys:Double x:Key="SsTitleBarHeight">40</sys:Double>
    <sys:Double x:Key="SsNavWidth">248</sys:Double>
    <sys:Double x:Key="SsNavWidthCompact">56</sys:Double>
    <sys:Double x:Key="SsIconSize">20</sys:Double>
    <sys:Double x:Key="SsIconSizeLarge">24</sys:Double>
    <sys:Double x:Key="SsControlHeight">36</sys:Double>
    <sys:Double x:Key="SsControlHeightLarge">44</sys:Double>

    <!-- Pencerenin altına düşemeyeceği ölçü: 1280x720'de her şey erişilebilir kalmalı. -->
    <sys:Double x:Key="SsWindowMinWidth">1040</sys:Double>
    <sys:Double x:Key="SsWindowMinHeight">640</sys:Double>

    <!-- ==================== Gölge ==================== -->
    <DropShadowEffect x:Key="SsShadowLow"
                      BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.28" Color="#000000" />
    <DropShadowEffect x:Key="SsShadowMedium"
                      BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.34" Color="#000000" />
    <DropShadowEffect x:Key="SsShadowHigh"
                      BlurRadius="48" ShadowDepth="14" Direction="270" Opacity="0.42" Color="#000000" />

</ResourceDictionary>

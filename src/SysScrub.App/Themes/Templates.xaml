<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:SysScrub.App.Converters"
                    xmlns:pages="clr-namespace:SysScrub.App.Views.Pages"
                    xmlns:views="clr-namespace:SysScrub.App.Views"
                    xmlns:vm="clr-namespace:SysScrub.App.ViewModels">

    <conv:GeometryKeyConverter x:Key="GeometryKey" />
    <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
    <views:PageTemplateSelector x:Key="PageTemplateSelector" />

    <!-- ==================== Yan menü öğesi ==================== -->
    <DataTemplate x:Key="NavItemTemplate" DataType="{x:Type vm:NavigationItem}">
        <Grid Margin="14,0,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Path Grid.Column="0"
                  Data="{Binding IconKey, Converter={StaticResource GeometryKey}}"
                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                  Stretch="Uniform"
                  Width="18" Height="18"
                  VerticalAlignment="Center" />

            <TextBlock Grid.Column="1"
                       Text="{Binding Title}"
                       Margin="12,0,0,0"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />

            <!-- Henüz gelmemiş modüller sessizce işaretlenir: kullanıcı boşuna tıklamasın. -->
            <Ellipse Grid.Column="2"
                     Width="5" Height="5"
                     VerticalAlignment="Center"
                     Fill="{DynamicResource SsTextDisabled}"
                     Visibility="{Binding IsReady, Converter={StaticResource InverseBoolToVisibility}}" />
        </Grid>
    </DataTemplate>

    <!-- ==================== Sayfa şablonları ==================== -->
    <DataTemplate x:Key="DashboardPageTemplate" DataType="{x:Type vm:NavigationItem}">
        <pages:DashboardPage />
    </DataTemplate>

    <DataTemplate x:Key="CleanerPageTemplate" DataType="{x:Type vm:NavigationItem}">
        <pages:CleanerPage />
    </DataTemplate>

    <DataTemplate x:Key="TimelinePageTemplate" DataType="{x:Type vm:NavigationItem}">
        <pages:TimelinePage />
    </DataTemplate>

    <DataTemplate x:Key="RegistryPageTemplate" DataType="{x:Type vm:NavigationItem}">
        <pages:RegistryPage />
    </DataTemplate>

    <DataTemplate x:Key="DriversPageTemplate" DataType="{x:Type vm:NavigationItem}">
        <pages:DriversPage />
    </DataTemplate>

    <DataTemplate x:Key="SoftwareUpdatesPageTemplate" DataType="{x:Type vm:NavigationItem}">
        <pages:SoftwareUpdatesPage />
    </DataTemplate>

    <DataTemplate x:Key="StartupPageTemplate" DataType="{x:Type vm:NavigationItem}">
        <pages:StartupPage />
    </DataTemplate>

    <DataTemplate x:Key="ProgramsPageTemplate" DataType="{x:Type vm:NavigationItem}">
        <pages:ProgramsPage />
    </DataTemplate>

    <DataTemplate x:Key="PlaceholderPageTemplate" DataType="{x:Type vm:NavigationItem}">
        <pages:ModulePlaceholderPage />
    </DataTemplate>

</ResourceDictionary>

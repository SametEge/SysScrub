<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Grafit & Sinyal — koyu tema.
        Tokens.Light.xaml birebir aynı anahtarları taşır; tema değişimi bu iki sözlüğün yer değiştirmesidir.

        Kural: vurgu rengi (SsAccent) yalnızca tıklanabilir öğelerde kullanılır.
        Durum renkleri (SsGood / SsCaution / SsDanger / SsInfo) yalnızca durum göstergelerinde.
        Bu ayrım, turuncu vurgunun "dikkat" uyarısıyla karışmasını engelleyen şeydir.
    -->

    <!-- ==================== Zemin ve yüzeyler ==================== -->
    <Color x:Key="SsGroundColor">#0E1013</Color>
    <Color x:Key="SsSurfaceColor">#17191D</Color>
    <Color x:Key="SsSurfaceRaisedColor">#1F2226</Color>
    <Color x:Key="SsSurfaceHoverColor">#262A2F</Color>
    <Color x:Key="SsBorderColor">#2A2E35</Color>
    <Color x:Key="SsBorderStrongColor">#3A404A</Color>

    <SolidColorBrush x:Key="SsGround" Color="{StaticResource SsGroundColor}" />
    <SolidColorBrush x:Key="SsSurface" Color="{StaticResource SsSurfaceColor}" />
    <SolidColorBrush x:Key="SsSurfaceRaised" Color="{StaticResource SsSurfaceRaisedColor}" />
    <SolidColorBrush x:Key="SsSurfaceHover" Color="{StaticResource SsSurfaceHoverColor}" />
    <SolidColorBrush x:Key="SsBorder" Color="{StaticResource SsBorderColor}" />
    <SolidColorBrush x:Key="SsBorderStrong" Color="{StaticResource SsBorderStrongColor}" />

    <!-- Mica'nın altından görünmesi için yarı saydam yüzey: pencere arkaplanı doku kazanır. -->
    <SolidColorBrush x:Key="SsSurfaceTranslucent" Color="#D617191D" />
    <SolidColorBrush x:Key="SsScrim" Color="#99000000" />

    <!-- ==================== Metin ==================== -->
    <Color x:Key="SsTextColor">#F2F3F5</Color>
    <Color x:Key="SsTextSecondaryColor">#9AA1AB</Color>
    <Color x:Key="SsTextDisabledColor">#646C77</Color>

    <SolidColorBrush x:Key="SsText" Color="{StaticResource SsTextColor}" />
    <SolidColorBrush x:Key="SsTextSecondary" Color="{StaticResource SsTextSecondaryColor}" />
    <SolidColorBrush x:Key="SsTextDisabled" Color="{StaticResource SsTextDisabledColor}" />

    <!-- ==================== Vurgu — yalnızca etkileşimli öğeler ==================== -->
    <Color x:Key="SsAccentColor">#FF6B2C</Color>
    <Color x:Key="SsAccentHoverColor">#FF834E</Color>
    <Color x:Key="SsAccentPressedColor">#E85A1E</Color>
    <Color x:Key="SsOnAccentColor">#12100E</Color>

    <SolidColorBrush x:Key="SsAccent" Color="{StaticResource SsAccentColor}" />
    <SolidColorBrush x:Key="SsAccentHover" Color="{StaticResource SsAccentHoverColor}" />
    <SolidColorBrush x:Key="SsAccentPressed" Color="{StaticResource SsAccentPressedColor}" />
    <SolidColorBrush x:Key="SsAccentTint" Color="#2EFF6B2C" />
    <SolidColorBrush x:Key="SsOnAccent" Color="{StaticResource SsOnAccentColor}" />
    <!-- Zemin üzerinde okunması gereken vurgu metni (bağlantılar) dolgudan farklı tonda. -->
    <SolidColorBrush x:Key="SsAccentText" Color="#FF8A55" />

    <!-- İkincil, sessiz vurgu: alıntı, etiket, ikincil grafik serisi. -->
    <SolidColorBrush x:Key="SsSand" Color="#E8D9C3" />

    <LinearGradientBrush x:Key="SsAccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#FF7A3A" />
        <GradientStop Offset="1" Color="#F04E12" />
    </LinearGradientBrush>

    <!-- ==================== Durum renkleri — yalnızca göstergeler ==================== -->
    <Color x:Key="SsGoodColor">#4ECB71</Color>
    <Color x:Key="SsCautionColor">#FFC93C</Color>
    <Color x:Key="SsDangerColor">#F2555A</Color>
    <Color x:Key="SsInfoColor">#4FA8E8</Color>

    <SolidColorBrush x:Key="SsGood" Color="{StaticResource SsGoodColor}" />
    <SolidColorBrush x:Key="SsCaution" Color="{StaticResource SsCautionColor}" />
    <SolidColorBrush x:Key="SsDanger" Color="{StaticResource SsDangerColor}" />
    <SolidColorBrush x:Key="SsInfo" Color="{StaticResource SsInfoColor}" />

    <SolidColorBrush x:Key="SsGoodTint" Color="#294ECB71" />
    <SolidColorBrush x:Key="SsCautionTint" Color="#29FFC93C" />
    <SolidColorBrush x:Key="SsDangerTint" Color="#29F2555A" />
    <SolidColorBrush x:Key="SsInfoTint" Color="#294FA8E8" />

    <!-- ==================== WPF-UI kaynaklarının üzerine yazımı ====================
         WPF-UI'nin hazır kontrolleri (TextBox, ComboBox, ScrollViewer, DataGrid...) bu
         anahtarları okur. Aynı isimleri yeniden tanımlayarak kütüphaneyi kendi kimliğimize
         çeviriyoruz — böylece "varsayılan WPF-UI uygulaması" gibi görünmüyor.
    -->
    <Color x:Key="ApplicationBackgroundColor">#0E1013</Color>
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#0E1013" />

    <Color x:Key="SolidBackgroundFillColorBase">#0E1013</Color>
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#0E1013" />
    <Color x:Key="SolidBackgroundFillColorBaseAlt">#08090B</Color>
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseAltBrush" Color="#08090B" />
    <Color x:Key="SolidBackgroundFillColorSecondary">#17191D</Color>
    <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="#17191D" />
    <Color x:Key="SolidBackgroundFillColorTertiary">#1F2226</Color>
    <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="#1F2226" />
    <Color x:Key="SolidBackgroundFillColorQuarternary">#262A2F</Color>
    <SolidColorBrush x:Key="SolidBackgroundFillColorQuarternaryBrush" Color="#262A2F" />

    <Color x:Key="CardBackgroundFillColorDefault">#17191D</Color>
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#17191D" />
    <Color x:Key="CardBackgroundFillColorSecondary">#1F2226</Color>
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#1F2226" />
    <Color x:Key="CardStrokeColorDefault">#2A2E35</Color>
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#2A2E35" />
    <Color x:Key="CardStrokeColorDefaultSolid">#2A2E35</Color>
    <SolidColorBrush x:Key="CardStrokeColorDefaultSolidBrush" Color="#2A2E35" />

    <Color x:Key="ControlFillColorDefault">#1F2226</Color>
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#1F2226" />
    <Color x:Key="ControlFillColorSecondary">#262A2F</Color>
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#262A2F" />
    <Color x:Key="ControlFillColorTertiary">#17191D</Color>
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#17191D" />

    <Color x:Key="ControlStrokeColorDefault">#2A2E35</Color>
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#2A2E35" />
    <Color x:Key="ControlStrokeColorSecondary">#3A404A</Color>
    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#3A404A" />

    <Color x:Key="TextFillColorPrimary">#F2F3F5</Color>
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#F2F3F5" />
    <Color x:Key="TextFillColorSecondary">#9AA1AB</Color>
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#9AA1AB" />
    <Color x:Key="TextFillColorTertiary">#7A828D</Color>
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#7A828D" />
    <Color x:Key="TextFillColorDisabled">#646C77</Color>
    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#646C77" />

    <Color x:Key="TextOnAccentFillColorPrimary">#12100E</Color>
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#12100E" />

    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FF6B2C" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#FF834E" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#E85A1E" />
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FF8A55" />

    <Color x:Key="DividerStrokeColorDefault">#2A2E35</Color>
    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#2A2E35" />

    <Color x:Key="FocusStrokeColorOuter">#FF6B2C</Color>
    <SolidColorBrush x:Key="FocusStrokeColorOuterBrush" Color="#FF6B2C" />

    <Color x:Key="LayerFillColorDefault">#17191D</Color>
    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#17191D" />
    <Color x:Key="LayerFillColorAlt">#1F2226</Color>
    <SolidColorBrush x:Key="LayerFillColorAltBrush" Color="#1F2226" />

    <Color x:Key="SubtleFillColorSecondary">#262A2F</Color>
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#262A2F" />
    <Color x:Key="SubtleFillColorTertiary">#1F2226</Color>
    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#1F2226" />

    <Color x:Key="SystemFillColorSuccess">#4ECB71</Color>
    <SolidColorBrush x:Key="SystemFillColorSuccessBrush" Color="#4ECB71" />
    <Color x:Key="SystemFillColorSuccessBackground">#1B2B20</Color>
    <SolidColorBrush x:Key="SystemFillColorSuccessBackgroundBrush" Color="#1B2B20" />
    <Color x:Key="SystemFillColorCaution">#FFC93C</Color>
    <SolidColorBrush x:Key="SystemFillColorCautionBrush" Color="#FFC93C" />
    <Color x:Key="SystemFillColorCautionBackground">#302713</Color>
    <SolidColorBrush x:Key="SystemFillColorCautionBackgroundBrush" Color="#302713" />
    <Color x:Key="SystemFillColorCritical">#F2555A</Color>
    <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="#F2555A" />
    <Color x:Key="SystemFillColorCriticalBackground">#2E1A1C</Color>
    <SolidColorBrush x:Key="SystemFillColorCriticalBackgroundBrush" Color="#2E1A1C" />
    <Color x:Key="SystemFillColorAttention">#4FA8E8</Color>
    <SolidColorBrush x:Key="SystemFillColorAttentionBrush" Color="#4FA8E8" />
    <Color x:Key="SystemFillColorAttentionBackground">#16242E</Color>
    <SolidColorBrush x:Key="SystemFillColorAttentionBackgroundBrush" Color="#16242E" />

</ResourceDictionary>

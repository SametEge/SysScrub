<UserControl x:Class="SysScrub.App.Views.Pages.DiskAnalysisPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SysScrub.App.Converters"
             xmlns:loc="clr-namespace:SysScrub.App.Localization"
             xmlns:controls="clr-namespace:SysScrub.App.Controls"
             xmlns:vm="clr-namespace:SysScrub.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:DiskAnalysisViewModel}">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:StringToVisibilityConverter x:Key="StringToVisibility" />
    </UserControl.Resources>

    <Grid>
      <Grid Margin="{StaticResource SsPagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ==================== Başlık ==================== -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="{loc:Str Nav_DiskAnalysis}" Style="{StaticResource SsDisplayText}" />
            <TextBlock Style="{StaticResource SsSecondaryText}" Margin="0,6,0,0"
                       Text="{loc:Str Da_Subtitle}" />
        </StackPanel>

        <!-- ==================== Sürücü seçici ==================== -->
        <Border Grid.Row="1" Style="{StaticResource SsCard}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ItemsControl Grid.Column="0" ItemsSource="{Binding Drives}" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:DriveChoiceViewModel}">
                            <Button Command="{Binding DataContext.SelectDriveCommand,
                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"
                                    Margin="0,0,8,0" Padding="16,9" MinHeight="0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SsSubtleButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SsAccentTint}" />
                                                <Setter Property="Foreground" Value="{DynamicResource SsAccentText}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>

                                <StackPanel>
                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="14" />
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource SsCaptionText}"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="18,0,18,0">
                    <TextBlock Text="{Binding HeadlineText}" Style="{StaticResource SsTitleText}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding HeadlineDetail}" Style="{StaticResource SsCaptionText}"
                               Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="{loc:Str Da_FindDuplicates}"
                            Style="{StaticResource SsSecondaryButton}"
                            Command="{Binding FindDuplicatesCommand}"
                            ToolTip="{loc:Str Da_FindDuplicatesTip}"
                            IsEnabled="{Binding HasScanned}"
                            Margin="0,0,8,0" MinWidth="150" />

                    <Button Content="{loc:Str Btn_StartScan}"
                            Style="{StaticResource SsPrimaryButton}"
                            Command="{Binding ScanCommand}"
                            MinWidth="150" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== Ekmek kırıntısı ==================== -->
        <Border Grid.Row="2" Margin="0,0,0,12"
                Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal">
                <Button Content="{loc:Str Da_Parent}" Style="{StaticResource SsSubtleButton}"
                        Command="{Binding GoUpCommand}"
                        MinHeight="28" Padding="10,0" FontSize="11.5" Margin="0,0,10,0" />

                <ItemsControl ItemsSource="{Binding Breadcrumb}" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:BreadcrumbStep}">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="{Binding Label}"
                                        Command="{Binding DataContext.OpenCommand,
                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding Node}"
                                        MinHeight="26" Padding="7,0" FontSize="11.5">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SsSubtleButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLast}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource SsText}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <TextBlock Text="›" Style="{StaticResource SsCaptionText}"
                                           VerticalAlignment="Center" Margin="2,0"
                                           Visibility="{Binding IsLast, Converter={StaticResource InverseBoolToVisibility}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- ==================== Ana içerik ==================== -->
        <Grid Grid.Row="3" Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
            <!-- Treemap + yan sütun -->
            <Grid Visibility="{Binding ShowDuplicates, Converter={StaticResource InverseBoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource SsCard}" Padding="4">
                    <controls:Treemap Root="{Binding Current}"
                                      AccentBrush="{DynamicResource SsAccent}"
                                      LabelBrush="White"
                                      NodeActivated="OnNodeActivated" />
                </Border>

                <!-- Yan sütun: en büyük dosyalar ve tür dağılımı -->
                <ScrollViewer Grid.Column="1" Width="360" Margin="12,0,0,0"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{loc:Str Da_LargestFiles}" Style="{StaticResource SsSectionLabel}"
                                   Margin="2,0,0,8" />

                        <ItemsControl ItemsSource="{Binding LargestFiles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="12,9" Margin="0,0,0,4"
                                            CornerRadius="{StaticResource SsRadiusSmall}"
                                            Background="{DynamicResource SsSurfaceRaised}"
                                            ToolTip="{Binding FullPath}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                       Style="{StaticResource SsBodyText}" FontSize="12.5"
                                                       TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />

                                            <TextBlock Grid.Column="1" Text="{Binding SizeLabel}"
                                                       Style="{StaticResource SsMonoText}" FontSize="11.5"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{loc:Str Da_TypeBreakdown}" Style="{StaticResource SsSectionLabel}"
                                   Margin="2,18,0,8" />

                        <ItemsControl ItemsSource="{Binding Types}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="12,9" Margin="0,0,0,4"
                                            CornerRadius="{StaticResource SsRadiusSmall}"
                                            Background="{DynamicResource SsSurfaceRaised}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                       Style="{StaticResource SsMonoText}" FontSize="11.5"
                                                       MinWidth="64" />

                                            <TextBlock Grid.Column="1" Text="{Binding Count, StringFormat={}{0:N0} dosya}"
                                                       Style="{StaticResource SsCaptionText}"
                                                       Margin="10,0,10,0" />

                                            <TextBlock Grid.Column="2" Text="{Binding SizeLabel}"
                                                       Style="{StaticResource SsMonoText}" FontSize="11.5" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Yinelenen dosyalar -->
            <Grid Visibility="{Binding ShowDuplicates, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="2,0,2,10">
                    <Button DockPanel.Dock="Right" Content="{loc:Str Da_BackToTreemap}"
                            Style="{StaticResource SsSubtleButton}"
                            Command="{Binding ToggleDuplicatesCommand}"
                            MinHeight="26" Padding="10,0" FontSize="11.5" />

                    <TextBlock Text="{Binding DuplicateSummary}" Style="{StaticResource SsSectionLabel}"
                               VerticalAlignment="Center" />
                </DockPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding DuplicateGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="14,12" Margin="0,0,0,6"
                                        CornerRadius="{StaticResource SsRadiusControl}"
                                        Background="{DynamicResource SsSurfaceRaised}"
                                        BorderBrush="{DynamicResource SsBorder}"
                                        BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding SizeLabel}"
                                                           Style="{StaticResource SsMonoText}"
                                                           FontSize="13" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Paths.Count, StringFormat=  × {0}}"
                                                           Style="{StaticResource SsCaptionText}"
                                                           VerticalAlignment="Center" />
                                                <Border Style="{StaticResource SsBadge}" Margin="10,0,0,0" Padding="7,1"
                                                        Background="{DynamicResource SsGoodTint}">
                                                    <TextBlock Text="{Binding RecoverableText}"
                                                               FontSize="10.5" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource SsGood}" />
                                                </Border>
                                            </StackPanel>

                                            <ItemsControl ItemsSource="{Binding Paths}" Margin="0,7,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}"
                                                                   Style="{StaticResource SsMonoText}"
                                                                   FontSize="11" Margin="0,1,12,0"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <Button Grid.Column="1" Content="{loc:Str Da_MoveExtras}"
                                                Style="{StaticResource SsSecondaryButton}"
                                                VerticalAlignment="Center" MinWidth="168"
                                                Command="{Binding DataContext.RemoveDuplicatesCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="{loc:Str Da_MoveExtrasTip}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Boş durum -->
        <Border Grid.Row="3" Style="{StaticResource SsCard}" Padding="40" MaxWidth="560"
                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0"
                Visibility="{Binding HasResult, Converter={StaticResource InverseBoolToVisibility}}">
            <StackPanel HorizontalAlignment="Center">
                <Border Width="64" Height="64" CornerRadius="{StaticResource SsRadiusPanel}"
                        Background="{DynamicResource SsSurfaceHover}" HorizontalAlignment="Center">
                    <Path Data="{StaticResource IconDiskAnalysis}" Fill="{DynamicResource SsTextSecondary}"
                          Stretch="Uniform" Width="30" Height="30"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <TextBlock Text="{loc:Str Da_EmptyTitle}" Style="{StaticResource SsSubtitleText}"
                           HorizontalAlignment="Center" Margin="0,18,0,0" />

                <TextBlock Style="{StaticResource SsSecondaryText}" TextAlignment="Center" Margin="0,8,0,0"
                           Text="{loc:Str Da_Empty}" />
            </StackPanel>
        </Border>

        <!-- ==================== Durum ==================== -->
        <StackPanel Grid.Row="4" Margin="0,12,0,0">
            <TextBlock Text="{Binding SkippedMessage}" Style="{StaticResource SsCaptionText}"
                       Margin="2,0,0,8" TextWrapping="Wrap"
                       Visibility="{Binding HasSkipped, Converter={StaticResource BoolToVisibility}}" />

            <Border Style="{StaticResource SsCard}"
                    Background="{DynamicResource SsSurfaceRaised}"
                    Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}">
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource SsBodyText}" TextWrapping="Wrap" />
            </Border>
        </StackPanel>
      </Grid>

      <!-- ==================== İşlem örtüsü ==================== -->
      <Grid Background="{DynamicResource SsScrim}"
            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
          <Border Style="{StaticResource SsCard}" Padding="40,36" MinWidth="420"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  Effect="{StaticResource SsShadowHigh}">
              <StackPanel HorizontalAlignment="Center">
                  <!-- Toplam dosya sayısı önceden bilinmiyor; sahte yüzde göstermiyoruz. -->
                  <controls:ScanRing Width="120" Height="120" Thickness="10"
                                     IsIndeterminate="True"
                                     TrackBrush="{DynamicResource SsSurfaceHover}"
                                     ProgressBrush="{DynamicResource SsAccentGradient}" />

                  <TextBlock Text="{Binding BusyTitle}" Style="{StaticResource SsTitleText}"
                             HorizontalAlignment="Center" Margin="0,22,0,0" />

                  <TextBlock Text="{Binding BusyDetail}" Style="{StaticResource SsSecondaryText}"
                             HorizontalAlignment="Center" TextAlignment="Center"
                             MaxWidth="380" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />

                  <Button Content="{loc:Str Btn_Cancel}" Style="{StaticResource SsSecondaryButton}"
                          Command="{Binding CancelCommand}" HorizontalAlignment="Center"
                          MinWidth="120" Margin="0,22,0,0" />
              </StackPanel>
          </Border>
      </Grid>
    </Grid>

</UserControl>

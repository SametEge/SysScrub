<UserControl x:Class="SysScrub.App.Views.Pages.StartupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SysScrub.App.Converters"
             xmlns:loc="clr-namespace:SysScrub.App.Localization"
             xmlns:controls="clr-namespace:SysScrub.App.Controls"
             xmlns:vm="clr-namespace:SysScrub.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:StartupViewModel}">

    <UserControl.Resources>
        <conv:GeometryKeyConverter x:Key="GeometryKey" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:StringToVisibilityConverter x:Key="StringToVisibility" />

        <!-- Başlangıç satırı: ad ve komut solda, ölçülen gecikme ve düğme sağda -->
        <DataTemplate x:Key="StartupRowTemplate" DataType="{x:Type vm:StartupRowViewModel}">
            <Border Padding="14,12" Margin="0,0,0,6"
                    CornerRadius="{StaticResource SsRadiusControl}"
                    Background="{DynamicResource SsSurfaceRaised}"
                    BorderBrush="{DynamicResource SsBorder}"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="38" Height="38" Margin="0,0,14,0"
                            CornerRadius="{StaticResource SsRadiusSmall}"
                            Background="{DynamicResource SsSurfaceHover}">
                        <Path Data="{Binding IconKey, Converter={StaticResource GeometryKey}}"
                              Fill="{DynamicResource SsTextSecondary}"
                              Stretch="Uniform" Width="19" Height="19"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" Style="{StaticResource SsBodyText}"
                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />

                            <Border Style="{StaticResource SsBadge}" Margin="8,0,0,0" Padding="7,1"
                                    Background="{DynamicResource SsSurfaceHover}">
                                <TextBlock Text="{Binding SourceLabel}" FontSize="10.5"
                                           Foreground="{DynamicResource SsTextSecondary}" />
                            </Border>

                            <!-- Hedefi kaybolmuş öğe: açılışta boşuna aranıyor -->
                            <Border Style="{StaticResource SsBadge}" Margin="6,0,0,0" Padding="7,1"
                                    Background="{DynamicResource SsCautionTint}"
                                    ToolTip="{loc:Str St_MissingTip}"
                                    Visibility="{Binding TargetMissing, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{loc:Str St_MissingBadge}" FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SsCaution}" />
                            </Border>
                        </StackPanel>

                        <TextBlock Text="{Binding Command}" Style="{StaticResource SsMonoText}"
                                   FontSize="11" Margin="0,3,12,0" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Command}" />

                        <TextBlock Text="{Binding ResultMessage}" Style="{StaticResource SsCaptionText}"
                                   Foreground="{DynamicResource SsCaution}"
                                   Margin="0,3,0,0" TextWrapping="Wrap" MaxWidth="620"
                                   HorizontalAlignment="Left"
                                   Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>

                    <!-- Ölçülen gecikme. Tahmin değil; ölçüm yoksa hiçbir şey yazılmaz. -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="16,0,20,0"
                                MinWidth="118" HorizontalAlignment="Right"
                                Visibility="{Binding HasDelay, Converter={StaticResource BoolToVisibility}}"
                                ToolTip="{loc:Str St_DelayTip}">
                        <TextBlock Text="{Binding DelayLabel}"
                                   FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource SsMonoText}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ImpactSeverity}" Value="caution">
                                            <Setter Property="Foreground" Value="{DynamicResource SsCaution}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ImpactSeverity}" Value="danger">
                                            <Setter Property="Foreground" Value="{DynamicResource SsDanger}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBlock Text="{Binding ImpactLabel}" Style="{StaticResource SsCaptionText}"
                                   HorizontalAlignment="Right" Margin="0,1,0,0" />
                    </StackPanel>

                    <Button Grid.Column="3" Content="{Binding ActionLabel}"
                            Style="{StaticResource SsSecondaryButton}"
                            MinWidth="132" VerticalAlignment="Center"
                            IsEnabled="{Binding IsToggleable}"
                            ToolTip="{Binding ReadOnlyReason}"
                            Command="{Binding DataContext.ToggleCommand,
                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
      <Grid Margin="{StaticResource SsPagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ==================== Başlık ==================== -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="{loc:Str Nav_Startup}" Style="{StaticResource SsDisplayText}" />
            <TextBlock Style="{StaticResource SsSecondaryText}" Margin="0,6,0,0"
                       Text="{loc:Str St_Subtitle}" />
        </StackPanel>

        <!-- ==================== Özet şeridi ==================== -->
        <Border Grid.Row="1" Style="{StaticResource SsCard}" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="44" Height="44" Margin="0,0,16,0"
                        CornerRadius="{StaticResource SsRadiusControl}"
                        Background="{DynamicResource SsAccentTint}">
                    <Path Data="{StaticResource IconStartup}" Fill="{DynamicResource SsAccent}"
                          Stretch="Uniform" Width="22" Height="22"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding HeadlineText}" Style="{StaticResource SsTitleText}" />
                    <TextBlock Text="{Binding HeadlineDetail}" Style="{StaticResource SsCaptionText}"
                               Margin="0,3,0,0" />
                </StackPanel>

                <Button Grid.Column="2" Content="{loc:Str Btn_Reload}"
                        Style="{StaticResource SsPrimaryButton}"
                        Command="{Binding LoadCommand}"
                        MinWidth="140" />
            </Grid>
        </Border>

        <!-- ==================== Liste ==================== -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Hedefi kaybolmuş öğeler -->
                <Border Style="{StaticResource SsCard}" Margin="0,0,0,12"
                        Background="{DynamicResource SsCautionTint}"
                        Visibility="{Binding HasBroken, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource SsIcon}" Data="{StaticResource IconStatusCaution}"
                              Fill="{DynamicResource SsCaution}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding BrokenMessage}" Style="{StaticResource SsBodyText}"
                                   Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Açık olanlar -->
                <StackPanel Visibility="{Binding HasEntries, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{loc:Str St_Running}" Style="{StaticResource SsSectionLabel}"
                               Margin="2,0,2,10" />

                    <ItemsControl ItemsSource="{Binding Enabled}"
                                  ItemTemplate="{StaticResource StartupRowTemplate}" />
                </StackPanel>

                <!-- Kapalı olanlar: katlanmış -->
                <Border Style="{StaticResource SsCard}" Padding="0" Margin="0,10,0,0"
                        Visibility="{Binding HasDisabled, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <Button Style="{StaticResource SsSubtleButton}"
                                Command="{Binding ToggleDisabledListCommand}"
                                HorizontalContentAlignment="Left"
                                HorizontalAlignment="Stretch"
                                MinHeight="44" Padding="20,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconStatusInfo}" Fill="{DynamicResource SsTextSecondary}"
                                      Stretch="Uniform" Width="16" Height="16" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding DisabledHeader}" Margin="10,0,0,0"
                                           VerticalAlignment="Center" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>

                        <ItemsControl ItemsSource="{Binding Disabled}"
                                      ItemTemplate="{StaticResource StartupRowTemplate}"
                                      Margin="14,0,14,14"
                                      Visibility="{Binding ShowDisabled, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Border>

                <!-- Boş durum -->
                <Border Style="{StaticResource SsCard}" Padding="40" MaxWidth="560"
                        HorizontalAlignment="Center" Margin="0,40,0,0"
                        Visibility="{Binding HasEntries, Converter={StaticResource InverseBoolToVisibility}}">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="64" Height="64" CornerRadius="{StaticResource SsRadiusPanel}"
                                Background="{DynamicResource SsSurfaceHover}" HorizontalAlignment="Center">
                            <Path Data="{StaticResource IconStartup}" Fill="{DynamicResource SsTextSecondary}"
                                  Stretch="Uniform" Width="30" Height="30"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <TextBlock Text="{Binding HeadlineText}" Style="{StaticResource SsSubtitleText}"
                                   HorizontalAlignment="Center" Margin="0,18,0,0" />

                        <TextBlock Style="{StaticResource SsSecondaryText}" TextAlignment="Center" Margin="0,8,0,0"
                                   Text="{loc:Str St_Empty}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ==================== Durum ==================== -->
        <Border Grid.Row="3" Style="{StaticResource SsCard}" Margin="0,14,0,0"
                Background="{DynamicResource SsSurfaceRaised}"
                Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}">
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource SsBodyText}" TextWrapping="Wrap" />
        </Border>
      </Grid>

      <!-- ==================== İşlem örtüsü ==================== -->
      <Grid Background="{DynamicResource SsScrim}"
            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
          <Border Style="{StaticResource SsCard}" Padding="40,36" MinWidth="380"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  Effect="{StaticResource SsShadowHigh}">
              <StackPanel HorizontalAlignment="Center">
                  <!-- Görev sayısı önceden bilinmiyor; sahte yüzde göstermiyoruz. -->
                  <controls:ScanRing Width="120" Height="120" Thickness="10"
                                     IsIndeterminate="True"
                                     TrackBrush="{DynamicResource SsSurfaceHover}"
                                     ProgressBrush="{DynamicResource SsAccentGradient}" />

                  <TextBlock Text="{Binding BusyTitle}" Style="{StaticResource SsTitleText}"
                             HorizontalAlignment="Center" Margin="0,22,0,0" />

                  <TextBlock Text="{Binding BusyDetail}" Style="{StaticResource SsSecondaryText}"
                             HorizontalAlignment="Center" TextAlignment="Center"
                             MaxWidth="320" Margin="0,6,0,0" />

                  <Button Content="{loc:Str Btn_Cancel}" Style="{StaticResource SsSecondaryButton}"
                          Command="{Binding CancelCommand}" HorizontalAlignment="Center"
                          MinWidth="120" Margin="0,22,0,0" />
              </StackPanel>
          </Border>
      </Grid>
    </Grid>

</UserControl>

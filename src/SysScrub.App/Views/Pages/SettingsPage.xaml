<UserControl x:Class="SysScrub.App.Views.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SysScrub.App.Converters"
             xmlns:loc="clr-namespace:SysScrub.App.Localization"
             xmlns:vm="clr-namespace:SysScrub.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SettingsViewModel}">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:StringToVisibilityConverter x:Key="StringToVisibility" />

        <!-- Tema seçim düğmesi: seçili olan vurgu renginde -->
        <Style x:Key="ChoiceButton" TargetType="Button" BasedOn="{StaticResource SsSubtleButton}">
            <Setter Property="MinWidth" Value="112" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <!-- Ayar satırı: solda ad ve açıklama, sağda denetim -->
        <Style x:Key="SettingRow" TargetType="Border">
            <Setter Property="Padding" Value="18,15" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="CornerRadius" Value="{StaticResource SsRadiusControl}" />
            <Setter Property="Background" Value="{DynamicResource SsSurfaceRaised}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SsBorder}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="{StaticResource SsPagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ==================== Başlık ==================== -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="{loc:Str Set_Title}" Style="{StaticResource SsDisplayText}" />
            <TextBlock Style="{StaticResource SsSecondaryText}" Margin="0,6,0,0"
                       Text="{loc:Str Set_Subtitle}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
            <StackPanel MaxWidth="900" HorizontalAlignment="Left">

                <!-- ==================== Görünüm ==================== -->
                <TextBlock Text="{loc:Str Set_Appearance}" Style="{StaticResource SsSectionLabel}" Margin="2,0,0,10" />

                <Border Style="{StaticResource SettingRow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="{loc:Str Set_Theme}" Style="{StaticResource SsBodyText}" FontWeight="SemiBold" />
                            <TextBlock Text="{loc:Str Set_Theme_Desc}"
                                       Style="{StaticResource SsCaptionText}" Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="{loc:Str Set_Theme_System}" Command="{Binding SetThemeCommand}" CommandParameter="system">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ChoiceButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSystemTheme}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SsAccentTint}" />
                                                <Setter Property="Foreground" Value="{DynamicResource SsAccentText}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Content="{loc:Str Set_Theme_Light}" Command="{Binding SetThemeCommand}" CommandParameter="light">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ChoiceButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLightTheme}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SsAccentTint}" />
                                                <Setter Property="Foreground" Value="{DynamicResource SsAccentText}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Content="{loc:Str Set_Theme_Dark}" Command="{Binding SetThemeCommand}" CommandParameter="dark" Margin="0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ChoiceButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDarkTheme}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SsAccentTint}" />
                                                <Setter Property="Foreground" Value="{DynamicResource SsAccentText}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingRow}">
                    <StackPanel>
                        <TextBlock Text="{loc:Str Set_Language}" Style="{StaticResource SsBodyText}"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{loc:Str Set_Language_Desc}" Style="{StaticResource SsCaptionText}"
                                   Margin="0,3,0,0" TextWrapping="Wrap" />

                        <ItemsControl ItemsSource="{Binding Languages}" Margin="0,12,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:LanguageChoice}">
                                    <Button Command="{Binding DataContext.SetLanguageCommand,
                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding Culture}"
                                            Margin="0,0,8,8" Padding="14,8" MinHeight="0">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SsSubtleButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource SsAccentTint}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource SsAccentText}" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>

                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />

                                            <TextBlock Text="{Binding CoverageLabel}" FontSize="10.5"
                                                       Margin="7,0,0,0" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource SsTextSecondary}"
                                                       Visibility="{Binding ShowCoverage, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{Binding CoverageNotice}" Style="{StaticResource SsCaptionText}"
                                   Foreground="{DynamicResource SsCaution}"
                                   Margin="0,2,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding HasCoverageNotice, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Border>

                <!-- ==================== Güvenlik ==================== -->
                <TextBlock Text="{loc:Str Set_Security}" Style="{StaticResource SsSectionLabel}" Margin="2,20,0,10" />

                <Border Style="{StaticResource SettingRow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="{loc:Str Set_RestorePoint}"
                                       Style="{StaticResource SsBodyText}" FontWeight="SemiBold" />
                            <TextBlock Text="{loc:Str Set_RestorePoint_Desc}"
                                       Style="{StaticResource SsCaptionText}" Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>

                        <CheckBox Grid.Column="1" VerticalAlignment="Center"
                                  IsChecked="{Binding CreateRestorePoint}" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingRow}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                                <TextBlock Text="{loc:Str Set_Retention}"
                                           Style="{StaticResource SsBodyText}" FontWeight="SemiBold" />
                                <TextBlock Text="{loc:Str Set_Retention_Desc}"
                                           Style="{StaticResource SsCaptionText}" Margin="0,3,0,0" TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Slider Width="180" VerticalAlignment="Center"
                                        Minimum="1" Maximum="90" TickFrequency="1"
                                        IsSnapToTickEnabled="True"
                                        Value="{Binding RetentionDays}" />

                                <TextBlock Text="{Binding RetentionLabel}" Style="{StaticResource SsMonoText}"
                                           VerticalAlignment="Center" Margin="14,0,0,0" MinWidth="58" />
                            </StackPanel>
                        </Grid>

                        <Rectangle Style="{StaticResource SsSeparator}" Height="1" Margin="0,14,0,12" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                                <TextBlock Text="{Binding QuarantineSummary}"
                                           Style="{StaticResource SsBodyText}" />
                                <TextBlock Text="{Binding QuarantinePath}" Style="{StaticResource SsMonoText}"
                                           FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="{loc:Str Set_OpenFolder}" Style="{StaticResource SsSubtleButton}"
                                        Command="{Binding OpenQuarantineFolderCommand}" Margin="0,0,8,0" />

                                <Button Content="{loc:Str Set_PurgeExpired}"
                                        Style="{StaticResource SsSecondaryButton}"
                                        Command="{Binding PurgeQuarantineCommand}"
                                        IsEnabled="{Binding HasQuarantine}"
                                        ToolTip="Yalnızca saklama süresini aşmış kayıtlar silinir. Bu işlem geri alınamaz." />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ==================== Zamanlanmış bakım ==================== -->
                <TextBlock Text="{loc:Str Set_Schedule}" Style="{StaticResource SsSectionLabel}" Margin="2,20,0,10" />

                <Border Style="{StaticResource SettingRow}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                                <TextBlock Text="{loc:Str Set_Weekly}"
                                           Style="{StaticResource SsBodyText}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding MaintenanceDetail}"
                                           Style="{StaticResource SsCaptionText}" Margin="0,3,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <CheckBox Grid.Column="1" VerticalAlignment="Center"
                                      IsChecked="{Binding ScheduledCleanup}"
                                      IsEnabled="{Binding CanSchedule}" />
                        </Grid>

                        <TextBlock Text="{Binding ScheduleBlockedReason}"
                                   Style="{StaticResource SsCaptionText}"
                                   Foreground="{DynamicResource SsCaution}"
                                   Margin="0,10,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding HasScheduleBlockedReason, Converter={StaticResource BoolToVisibility}}" />

                        <Rectangle Style="{StaticResource SsSeparator}" Height="1" Margin="0,14,0,12" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                                <TextBlock Text="{loc:Str Set_Hour}" Style="{StaticResource SsBodyText}" />
                                <TextBlock Text="{loc:Str Set_Hour_Desc}"
                                           Style="{StaticResource SsCaptionText}" Margin="0,3,0,0" TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Slider Width="180" VerticalAlignment="Center"
                                        Minimum="0" Maximum="23" TickFrequency="1"
                                        IsSnapToTickEnabled="True"
                                        Value="{Binding ScheduledHour}" />

                                <TextBlock Text="{Binding ScheduleLabel}" Style="{StaticResource SsCaptionText}"
                                           VerticalAlignment="Center" Margin="14,0,0,0" MinWidth="150" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ==================== Veri ==================== -->
                <TextBlock Text="{loc:Str Set_Data}" Style="{StaticResource SsSectionLabel}" Margin="2,20,0,10" />

                <Border Style="{StaticResource SettingRow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="{loc:Str Set_DataFolder}" Style="{StaticResource SsBodyText}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding DataDirectory}" Style="{StaticResource SsMonoText}"
                                       FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding StorageModeLabel}" Style="{StaticResource SsCaptionText}"
                                       Margin="0,5,0,0" TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="{loc:Str Set_Logs}" Style="{StaticResource SsSubtleButton}"
                                    Command="{Binding OpenLogsFolderCommand}" Margin="0,0,8,0" />

                            <Button Content="{loc:Str Set_OpenData}" Style="{StaticResource SsSecondaryButton}"
                                    Command="{Binding OpenDataFolderCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ==================== Uygulama güncellemesi ==================== -->
                <TextBlock Text="{loc:Str Set_Update}" Style="{StaticResource SsSectionLabel}" Margin="2,20,0,10" />

                <Border Style="{StaticResource SettingRow}" DataContext="{Binding Update}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                                <TextBlock Text="{loc:Str Set_Update_Auto}" Style="{StaticResource SsBodyText}"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{loc:Str Set_Update_Auto_Desc}"
                                           Style="{StaticResource SsCaptionText}" Margin="0,3,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <CheckBox Grid.Column="1" VerticalAlignment="Center"
                                      IsChecked="{Binding AutoCheck}" />
                        </Grid>

                        <Rectangle Style="{StaticResource SsSeparator}" Height="1" Margin="0,14,0,12" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource SsBodyText}"
                                           TextWrapping="Wrap" />

                                <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100"
                                             Height="6" Margin="0,8,0,0"
                                             Background="{DynamicResource SsSurfaceHover}"
                                             Foreground="{DynamicResource SsAccent}"
                                             BorderThickness="0"
                                             Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibility}}" />

                                <TextBlock Text="{Binding VerificationNotice}"
                                           Style="{StaticResource SsCaptionText}" Margin="0,6,0,0"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding HasVerificationNotice, Converter={StaticResource BoolToVisibility}}" />

                                <TextBlock Text="{Binding PortableNotice}"
                                           Style="{StaticResource SsCaptionText}"
                                           Foreground="{DynamicResource SsCaution}"
                                           Margin="0,6,0,0" TextWrapping="Wrap"
                                           Visibility="{Binding HasPortableNotice, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="{loc:Str Set_Update_Page}" Style="{StaticResource SsSubtleButton}"
                                        Command="{Binding OpenReleasePageCommand}" Margin="0,0,8,0"
                                        Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVisibility}}" />

                                <Button Content="{loc:Str Set_Update_Download}" Style="{StaticResource SsSecondaryButton}"
                                        Command="{Binding DownloadCommand}" Margin="0,0,8,0"
                                        Visibility="{Binding CanDownload, Converter={StaticResource BoolToVisibility}}" />

                                <Button Content="{loc:Str Set_Update_Install}" Style="{StaticResource SsPrimaryButton}"
                                        Command="{Binding InstallCommand}" Margin="0,0,8,0"
                                        Visibility="{Binding CanInstall, Converter={StaticResource BoolToVisibility}}" />

                                <Button Content="{loc:Str Set_Update_Check}" Style="{StaticResource SsSubtleButton}"
                                        Command="{Binding CheckCommand}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{Binding ReleaseNotes}" Style="{StaticResource SsCaptionText}"
                                   Margin="0,12,0,0" TextWrapping="Wrap" MaxHeight="120"
                                   Visibility="{Binding HasReleaseNotes, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Border>

                <!-- ==================== Hakkında ==================== -->
                <TextBlock Text="{loc:Str Set_About}" Style="{StaticResource SsSectionLabel}" Margin="2,20,0,10" />

                <Border Style="{StaticResource SettingRow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="SysScrub" Style="{StaticResource SsBodyText}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding VersionText}"
                                           Style="{StaticResource SsMonoText}" FontSize="11.5"
                                           VerticalAlignment="Center" Margin="6,0,0,0" />
                            </StackPanel>

                            <TextBlock Text="{Binding SystemLabel}" Style="{StaticResource SsCaptionText}"
                                       Margin="0,4,0,0" />

                            <TextBlock Text="{loc:Str Set_License}"
                                       Style="{StaticResource SsCaptionText}" Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="{loc:Str Set_ShowTour}" Style="{StaticResource SsSubtleButton}"
                                    Command="{Binding ShowTourCommand}" Margin="0,0,8,0" />

                            <Button Content="{loc:Str Set_Refresh}" Style="{StaticResource SsSubtleButton}"
                                    Command="{Binding RefreshCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Text="{Binding SettingsFileLabel}"
                           Style="{StaticResource SsCaptionText}" Margin="2,12,0,0"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </ScrollViewer>

        <!-- ==================== Durum ==================== -->
        <Border Grid.Row="2" Style="{StaticResource SsCard}" Margin="0,14,0,0"
                Background="{DynamicResource SsSurfaceRaised}"
                Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}">
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource SsBodyText}" TextWrapping="Wrap" />
        </Border>
    </Grid>

</UserControl>

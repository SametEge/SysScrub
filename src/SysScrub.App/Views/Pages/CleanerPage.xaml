<UserControl x:Class="SysScrub.App.Views.Pages.CleanerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SysScrub.App.Converters"
             xmlns:controls="clr-namespace:SysScrub.App.Controls"
             xmlns:cleaner="clr-namespace:SysScrub.App.ViewModels.Cleaner"
             xmlns:vm="clr-namespace:SysScrub.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:CleanerViewModel}">

    <UserControl.Resources>
        <conv:GeometryKeyConverter x:Key="GeometryKey" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:StringToVisibilityConverter x:Key="StringToVisibility" />
        <conv:PositiveToVisibilityConverter x:Key="PositiveToVisibility" />
        <conv:RiskBrushConverter x:Key="RiskBrush" />
        <conv:RiskTintConverter x:Key="RiskTint" />
    </UserControl.Resources>

    <Grid>
      <Grid Margin="{StaticResource SsPagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ==================== Başlık ==================== -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Temizleyici" Style="{StaticResource SsDisplayText}" />
            <TextBlock Style="{StaticResource SsSecondaryText}" Margin="0,6,0,0"
                       Text="Tarama hiçbir şey silmez. Ne silineceğine listeden sen karar verirsin; silinenler karantinaya gider ve geri alınabilir." />
        </StackPanel>

        <!-- ==================== Durum şeridi ==================== -->
        <Border Grid.Row="1" Style="{StaticResource SsCard}" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Sol: bulunan / seçilen -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <StackPanel Margin="0,0,32,0">
                        <TextBlock Text="BULUNAN" Style="{StaticResource SsSectionLabel}" />
                        <TextBlock Text="{Binding FoundLabel}" Style="{StaticResource SsMetricValue}"
                                   FontSize="26" Margin="0,4,0,0" />
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="SEÇİLİ" Style="{StaticResource SsSectionLabel}" />
                        <TextBlock Text="{Binding SelectedLabel}" Style="{StaticResource SsMetricValue}"
                                   FontSize="26" Margin="0,4,0,0"
                                   Foreground="{DynamicResource SsAccentText}" />
                    </StackPanel>
                </StackPanel>

                <!-- Orta: ilerleme -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="32,0"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding ProgressLabel}" Style="{StaticResource SsCaptionText}"
                               TextTrimming="CharacterEllipsis" />
                    <ProgressBar Value="{Binding ProgressFraction, Mode=OneWay}" Maximum="1"
                                 Height="6" Margin="0,6,0,0"
                                 Background="{DynamicResource SsSurfaceHover}"
                                 Foreground="{DynamicResource SsAccent}"
                                 BorderThickness="0" />
                </StackPanel>

                <!-- Sağ: eylemler -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="İptal"
                            Style="{StaticResource SsSecondaryButton}"
                            Command="{Binding CancelCommand}"
                            Margin="0,0,8,0"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

                    <Button Content="Taramayı başlat"
                            Style="{StaticResource SsSecondaryButton}"
                            Command="{Binding ScanCommand}"
                            Margin="0,0,8,0"
                            MinWidth="140" />

                    <Button Content="Seçilenleri temizle"
                            Style="{StaticResource SsPrimaryButton}"
                            Command="{Binding CleanCommand}"
                            MinWidth="160" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== Kural ağacı ==================== -->
        <Border Grid.Row="2" Style="{StaticResource SsCard}" Padding="0">
            <DockPanel>

                <!-- Seçim araç çubuğu -->
                <Border DockPanel.Dock="Top" Padding="16,12"
                        BorderBrush="{DynamicResource SsBorder}" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Seçim:" Style="{StaticResource SsCaptionText}"
                                   VerticalAlignment="Center" Margin="0,0,10,0" />
                        <Button Content="Önerilen" Style="{StaticResource SsSubtleButton}"
                                Command="{Binding SelectRecommendedCommand}" MinHeight="28" Padding="10,0" FontSize="12" />
                        <Button Content="Tümü" Style="{StaticResource SsSubtleButton}"
                                Command="{Binding SelectAllCommand}" MinHeight="28" Padding="10,0" FontSize="12" />
                        <Button Content="Hiçbiri" Style="{StaticResource SsSubtleButton}"
                                Command="{Binding SelectNoneCommand}" MinHeight="28" Padding="10,0" FontSize="12" />

                        <TextBlock Style="{StaticResource SsCaptionText}" VerticalAlignment="Center" Margin="20,0,0,0"
                                   Text="Yönetici hakkı olmadan bazı sistem kuralları atlanır."
                                   Visibility="{Binding IsElevated, Converter={StaticResource InverseBoolToVisibility}}" />
                    </StackPanel>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,8,8,8">
                    <ItemsControl ItemsSource="{Binding Categories}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type cleaner:CategoryNodeViewModel}">
                                <Expander IsExpanded="{Binding IsExpanded}" Margin="0,0,0,4" Background="Transparent">

                                    <!-- Kategori başlığı -->
                                    <Expander.Header>
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0"
                                                      IsThreeState="True"
                                                      IsChecked="{Binding IsSelected}"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,10,0" />

                                            <Path Grid.Column="1"
                                                  Data="{Binding IconKey, Converter={StaticResource GeometryKey}}"
                                                  Fill="{DynamicResource SsTextSecondary}"
                                                  Stretch="Uniform" Width="17" Height="17"
                                                  VerticalAlignment="Center" Margin="0,0,10,0" />

                                            <TextBlock Grid.Column="2" Text="{Binding Title}"
                                                       Style="{StaticResource SsSubtitleText}"
                                                       VerticalAlignment="Center" />

                                            <TextBlock Grid.Column="3" Text="{Binding SelectionLabel}"
                                                       Style="{StaticResource SsCaptionText}"
                                                       VerticalAlignment="Center" Margin="0,0,16,0" />

                                            <TextBlock Grid.Column="4" Text="{Binding SizeLabel}"
                                                       Style="{StaticResource SsBodyText}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource SsAccentText}"
                                                       VerticalAlignment="Center" Margin="0,0,12,0" />
                                        </Grid>
                                    </Expander.Header>

                                    <!-- Gruplar -->
                                    <ItemsControl ItemsSource="{Binding Groups}" Margin="30,4,0,10">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type cleaner:GroupNodeViewModel}">
                                                <StackPanel Margin="0,0,0,10">
                                                    <TextBlock Text="{Binding Name}"
                                                               Style="{StaticResource SsSectionLabel}"
                                                               Margin="0,0,0,4" />

                                                    <ItemsControl ItemsSource="{Binding Rules}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type cleaner:RuleNodeViewModel}">
                                                                <Border Padding="8,7" CornerRadius="{StaticResource SsRadiusSmall}"
                                                                        Background="Transparent">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Style.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter Property="Background" Value="{DynamicResource SsSurfaceHover}" />
                                                                                </Trigger>
                                                                                <!-- Tarandı ama bulgu yok: silikleşir, kaybolmaz. -->
                                                                                <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                                                                    <Setter Property="Opacity" Value="0.45" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>

                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>

                                                                        <CheckBox Grid.Column="0"
                                                                                  IsChecked="{Binding IsSelected}"
                                                                                  VerticalAlignment="Top"
                                                                                  Margin="0,1,10,0" />

                                                                        <StackPanel Grid.Column="1">
                                                                            <StackPanel Orientation="Horizontal">
                                                                                <TextBlock Text="{Binding Title}"
                                                                                           Style="{StaticResource SsBodyText}" />

                                                                                <!-- Risk rozeti: renk + metin, renk körlüğünde de okunur -->
                                                                                <Border Style="{StaticResource SsBadge}"
                                                                                        Margin="8,0,0,0" Padding="7,1"
                                                                                        Background="{Binding Risk, Converter={StaticResource RiskTint}}"
                                                                                        Visibility="{Binding ShowRiskBadge, Converter={StaticResource BoolToVisibility}}">
                                                                                    <TextBlock Text="{Binding RiskLabel}" FontSize="10.5"
                                                                                               FontWeight="SemiBold"
                                                                                               Foreground="{Binding Risk, Converter={StaticResource RiskBrush}}" />
                                                                                </Border>

                                                                                <Border Style="{StaticResource SsBadge}"
                                                                                        Margin="6,0,0,0" Padding="7,1"
                                                                                        Background="{DynamicResource SsSurfaceHover}"
                                                                                        Visibility="{Binding RequiresAdmin, Converter={StaticResource BoolToVisibility}}">
                                                                                    <TextBlock Text="yönetici" FontSize="10.5"
                                                                                               Foreground="{DynamicResource SsTextSecondary}" />
                                                                                </Border>
                                                                            </StackPanel>

                                                                            <TextBlock Text="{Binding Explanation}"
                                                                                       Style="{StaticResource SsCaptionText}"
                                                                                       Margin="0,3,16,0"
                                                                                       MaxWidth="720"
                                                                                       HorizontalAlignment="Left"
                                                                                       Visibility="{Binding HasExplanation, Converter={StaticResource BoolToVisibility}}" />

                                                                            <TextBlock Text="{Binding BlockersLabel}"
                                                                                       Style="{StaticResource SsCaptionText}"
                                                                                       Foreground="{DynamicResource SsCaution}"
                                                                                       Margin="0,3,0,0"
                                                                                       Visibility="{Binding HasBlockers, Converter={StaticResource BoolToVisibility}}" />

                                                                            <TextBlock Text="{Binding ElevationNote}"
                                                                                       Style="{StaticResource SsCaptionText}"
                                                                                       Foreground="{DynamicResource SsInfo}"
                                                                                       Margin="0,3,0,0"
                                                                                       Visibility="{Binding IsBlockedByElevation, Converter={StaticResource BoolToVisibility}}" />
                                                                        </StackPanel>

                                                                        <TextBlock Grid.Column="2"
                                                                                   Text="{Binding CountLabel}"
                                                                                   Style="{StaticResource SsCaptionText}"
                                                                                   VerticalAlignment="Top"
                                                                                   Margin="0,1,14,0" />

                                                                        <TextBlock Grid.Column="3"
                                                                                   Text="{Binding SizeLabel}"
                                                                                   Style="{StaticResource SsBodyText}"
                                                                                   FontWeight="SemiBold"
                                                                                   VerticalAlignment="Top"
                                                                                   MinWidth="72"
                                                                                   TextAlignment="Right"
                                                                                   Margin="0,1,4,0" />
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ==================== Sonuç / durum ==================== -->
        <Border Grid.Row="3" Style="{StaticResource SsCard}" Margin="0,16,0,0"
                Background="{DynamicResource SsSurfaceRaised}"
                Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}">
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource SsBodyText}" />
        </Border>

        <Border Grid.Row="3" Style="{StaticResource SsCard}" Margin="0,16,0,0"
                Background="{DynamicResource SsSurfaceRaised}"
                Visibility="{Binding ResultSummary, Converter={StaticResource StringToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Path Grid.Column="0" Data="{StaticResource IconStatusGood}"
                      Fill="{DynamicResource SsGood}" Stretch="Uniform"
                      Width="22" Height="22" VerticalAlignment="Center" Margin="0,0,14,0" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ResultSummary}" Style="{StaticResource SsSubtitleText}" />
                    <TextBlock Text="{Binding ResultDetail}" Style="{StaticResource SsCaptionText}" Margin="0,2,0,0" />
                </StackPanel>

                <Button Grid.Column="2" Content="Geri al"
                        Style="{StaticResource SsSecondaryButton}"
                        Command="{Binding UndoCommand}"
                        VerticalAlignment="Center"
                        Visibility="{Binding CanUndoLastClean, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Border>
      </Grid>

      <!--
          İşlem örtüsü. Tarama ve temizlik arka planda çalışıyor; örtü hem ne olduğunu
          gösteriyor hem de altındaki listeye tıklanmasını engelliyor.
      -->
      <Grid Background="{DynamicResource SsScrim}"
            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">

          <Border Style="{StaticResource SsCard}"
                  Padding="40,36"
                  MinWidth="380"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Effect="{StaticResource SsShadowHigh}">
              <StackPanel HorizontalAlignment="Center">

                  <Grid Width="150" Height="150">
                      <controls:ScanRing Width="150" Height="150"
                                         Thickness="12"
                                         Progress="{Binding ProgressFraction, Mode=OneWay}"
                                         TrackBrush="{DynamicResource SsSurfaceHover}"
                                         ProgressBrush="{DynamicResource SsAccentGradient}" />

                      <TextBlock Text="{Binding ProgressPercentLabel}"
                                 Style="{StaticResource SsMetricValue}"
                                 FontSize="28"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center" />
                  </Grid>

                  <TextBlock Text="{Binding BusyTitle}"
                             Style="{StaticResource SsTitleText}"
                             HorizontalAlignment="Center"
                             Margin="0,22,0,0" />

                  <TextBlock Text="{Binding BusyDetail}"
                             Style="{StaticResource SsSecondaryText}"
                             HorizontalAlignment="Center"
                             TextAlignment="Center"
                             Margin="0,6,0,0" />

                  <!-- Hangi kuralda olduğumuz: uzun taramada "takıldı mı" sorusunu önler -->
                  <TextBlock Text="{Binding ProgressLabel}"
                             Style="{StaticResource SsCaptionText}"
                             HorizontalAlignment="Center"
                             TextAlignment="Center"
                             TextTrimming="CharacterEllipsis"
                             MaxWidth="320"
                             Margin="0,10,0,0" />

                  <Button Content="İptal"
                          Style="{StaticResource SsSecondaryButton}"
                          Command="{Binding CancelCommand}"
                          HorizontalAlignment="Center"
                          MinWidth="120"
                          Margin="0,22,0,0" />

                  <TextBlock Text="İptal edersen o ana kadar silinenler karantinada kalır, geri alabilirsin."
                             Style="{StaticResource SsCaptionText}"
                             HorizontalAlignment="Center"
                             TextAlignment="Center"
                             MaxWidth="300"
                             Margin="0,10,0,0" />
              </StackPanel>
          </Border>
      </Grid>
    </Grid>

</UserControl>

<UserControl x:Class="SysScrub.App.Views.Pages.ModulePlaceholderPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SysScrub.App.ViewModels"
             xmlns:conv="clr-namespace:SysScrub.App.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:NavigationItem}">

    <UserControl.Resources>
        <conv:GeometryKeyConverter x:Key="GeometryKey" />
    </UserControl.Resources>

    <!--
        Boş ekran yerine dürüst ekran: modülün ne yapacağını ve hangi fazda geleceğini söyler.
        Kullanıcı uygulamanın bozuk olduğunu düşünmesin.
    -->
    <Grid Margin="{StaticResource SsPagePadding}">
        <Border Style="{StaticResource SsCard}"
                MaxWidth="620"
                Padding="40"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel HorizontalAlignment="Center">

                <Border Width="72" Height="72"
                        CornerRadius="{StaticResource SsRadiusPanel}"
                        Background="{DynamicResource SsAccentTint}"
                        HorizontalAlignment="Center">
                    <Path Data="{Binding IconKey, Converter={StaticResource GeometryKey}}"
                          Fill="{DynamicResource SsAccent}"
                          Stretch="Uniform"
                          Width="34" Height="34"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                </Border>

                <TextBlock Text="{Binding Title}"
                           Style="{StaticResource SsDisplayText}"
                           HorizontalAlignment="Center"
                           Margin="0,24,0,0" />

                <TextBlock Text="{Binding Description}"
                           Style="{StaticResource SsSecondaryText}"
                           TextAlignment="Center"
                           Margin="0,12,0,0" />

                <Border Style="{StaticResource SsBadge}"
                        Background="{DynamicResource SsSurfaceHover}"
                        HorizontalAlignment="Center"
                        Margin="0,24,0,0"
                        Padding="14,6">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconTimeline}"
                              Fill="{DynamicResource SsTextSecondary}"
                              Stretch="Uniform"
                              Width="14" Height="14"
                              VerticalAlignment="Center" />
                        <TextBlock VerticalAlignment="Center" Margin="8,0,0,0" FontSize="12"
                                   Foreground="{DynamicResource SsTextSecondary}">
                            <Run Text="Faz" />
                            <Run Text="{Binding Phase, Mode=OneWay}" FontWeight="SemiBold" />
                            <Run Text="ile geliyor" />
                        </TextBlock>
                    </StackPanel>
                </Border>

            </StackPanel>
        </Border>
    </Grid>

</UserControl>

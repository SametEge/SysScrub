<UserControl x:Class="SysScrub.App.Views.Pages.DriversPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SysScrub.App.Converters"
             xmlns:controls="clr-namespace:SysScrub.App.Controls"
             xmlns:vm="clr-namespace:SysScrub.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:DriversViewModel}">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:StringToVisibilityConverter x:Key="StringToVisibility" />
    </UserControl.Resources>

    <Grid>
      <Grid Margin="{StaticResource SsPagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ==================== Başlık ==================== -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Sürücüler" Style="{StaticResource SsDisplayText}" />
            <TextBlock Style="{StaticResource SsSecondaryText}" Margin="0,6,0,0"
                       Text="Donanımını tanır, sorunlu cihazları ve eski sürücüleri gösterir. Güncelleme kaynağı Windows Update — buradan gelen her sürücü WHQL imzalı." />
        </StackPanel>

        <!-- ==================== Özet ve eylemler ==================== -->
        <Border Grid.Row="1" Style="{StaticResource SsCard}" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <StackPanel Margin="0,0,32,0">
                        <TextBlock Text="CİHAZ" Style="{StaticResource SsSectionLabel}" />
                        <TextBlock Text="{Binding DeviceCountLabel}" Style="{StaticResource SsMetricValue}"
                                   FontSize="26" Margin="0,4,0,0" />
                    </StackPanel>

                    <StackPanel Margin="0,0,32,0">
                        <TextBlock Text="SORUNLU" Style="{StaticResource SsSectionLabel}" />
                        <TextBlock Text="{Binding ProblemCountLabel}" FontSize="26" Margin="0,4,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource SsMetricValue}">
                                    <Style.Triggers>
                                        <!-- Sorun varsa sayı kırmızıya döner; yoksa nötr kalır. -->
                                        <DataTrigger Binding="{Binding HasProblems}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource SsDanger}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="ESKİ SÜRÜCÜ" Style="{StaticResource SsSectionLabel}" />
                        <TextBlock Text="{Binding AgingCount}" Style="{StaticResource SsMetricValue}"
                                   FontSize="26" Margin="0,4,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="Sürücüleri yedekle"
                            Style="{StaticResource SsSecondaryButton}"
                            Command="{Binding BackupCommand}"
                            ToolTip="Tüm üçüncü parti sürücüleri dışa aktarır. Yönetici hakkı gerekir."
                            Margin="0,0,8,0" />

                    <Button Content="Donanımı oku"
                            Style="{StaticResource SsSecondaryButton}"
                            Command="{Binding LoadCommand}"
                            Margin="0,0,8,0" MinWidth="130" />

                    <Button Content="Güncelleme ara"
                            Style="{StaticResource SsPrimaryButton}"
                            Command="{Binding CheckUpdatesCommand}"
                            MinWidth="150" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== İçerik ==================== -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Windows Update sonucu -->
                <Border Style="{StaticResource SsCard}" Margin="0,0,0,12"
                        Background="{DynamicResource SsSurfaceRaised}"
                        Visibility="{Binding UpdateMessage, Converter={StaticResource StringToVisibility}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource SsIcon}" Data="{StaticResource IconUpdates}"
                                  Fill="{DynamicResource SsInfo}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding UpdateMessage}" Style="{StaticResource SsBodyText}"
                                       Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding Updates}" Margin="34,12,0,0"
                                      Visibility="{Binding HasUpdates, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:DriverUpdateRowViewModel}">
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource SsBodyText}" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource SsCaptionText}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Sorunlu cihazlar -->
                <Border Style="{StaticResource SsCard}" Margin="0,0,0,12"
                        Background="{DynamicResource SsDangerTint}"
                        BorderBrush="{DynamicResource SsDanger}"
                        Visibility="{Binding HasProblems, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Path Style="{StaticResource SsIcon}" Data="{StaticResource IconStatusDanger}"
                                  Fill="{DynamicResource SsDanger}" VerticalAlignment="Center" />
                            <TextBlock Text="Sorun bildiren cihazlar" Style="{StaticResource SsSubtitleText}"
                                       Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding ProblemDevices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:DeviceRowViewModel}">
                                    <StackPanel Margin="34,0,0,10">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource SsBodyText}" />
                                        <TextBlock Text="{Binding ProblemDescription}"
                                                   Style="{StaticResource SsCaptionText}"
                                                   Foreground="{DynamicResource SsDanger}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Eski sürücüler -->
                <Border Style="{StaticResource SsCard}" Margin="0,0,0,12"
                        Visibility="{Binding HasAging, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="İKİ YILDAN ESKİ SÜRÜCÜLER" Style="{StaticResource SsSectionLabel}" />
                        <TextBlock Style="{StaticResource SsCaptionText}" Margin="0,4,0,12"
                                   Text="Eski olması sorunlu olduğu anlamına gelmez. Bir şey çalışmıyorsa ya da oyun başarımı düşükse önce bunlara bakılır." />

                        <ItemsControl ItemsSource="{Binding AgingDevices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:DeviceRowViewModel}">
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource SsBodyText}" />
                                            <TextBlock Text="{Binding ProviderLabel}" Style="{StaticResource SsCaptionText}" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="1" Text="{Binding VersionLabel}"
                                                   Style="{StaticResource SsMonoText}"
                                                   VerticalAlignment="Center" Margin="16,0" />

                                        <Border Grid.Column="2" Style="{StaticResource SsBadge}"
                                                Background="{DynamicResource SsCautionTint}"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding AgeLabel}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource SsCaution}" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Tüm cihazlar -->
                <Border Style="{StaticResource SsCard}" Padding="0"
                        Visibility="{Binding HasLoaded, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <Border Padding="20,14" BorderBrush="{DynamicResource SsBorder}" BorderThickness="0,0,0,1">
                            <TextBlock Text="TÜM CİHAZLAR" Style="{StaticResource SsSectionLabel}" />
                        </Border>

                        <ItemsControl ItemsSource="{Binding Groups}" Margin="8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:DeviceGroupViewModel}">
                                    <Expander IsExpanded="{Binding IsExpanded}" Margin="0,0,0,2" Background="Transparent">
                                        <Expander.Header>
                                            <Grid Margin="0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{Binding Title}"
                                                           Style="{StaticResource SsBodyText}"
                                                           FontWeight="SemiBold" VerticalAlignment="Center" />

                                                <Border Grid.Column="1" Style="{StaticResource SsBadge}"
                                                        Background="{DynamicResource SsDangerTint}"
                                                        Margin="0,0,10,0"
                                                        Visibility="{Binding HasProblems, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="{Binding ProblemLabel}" FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource SsDanger}" />
                                                </Border>

                                                <TextBlock Grid.Column="2" Text="{Binding CountLabel}"
                                                           Style="{StaticResource SsCaptionText}"
                                                           VerticalAlignment="Center" Margin="0,0,12,0" />
                                            </Grid>
                                        </Expander.Header>

                                        <ItemsControl ItemsSource="{Binding Devices}" Margin="24,4,0,10">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:DeviceRowViewModel}">
                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="{Binding Name}"
                                                                       Style="{StaticResource SsBodyText}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding ProblemDescription}"
                                                                       Style="{StaticResource SsCaptionText}"
                                                                       Foreground="{DynamicResource SsDanger}"
                                                                       Visibility="{Binding HasProblem, Converter={StaticResource BoolToVisibility}}" />
                                                        </StackPanel>

                                                        <TextBlock Grid.Column="1" Text="{Binding VersionLabel}"
                                                                   Style="{StaticResource SsMonoText}"
                                                                   VerticalAlignment="Center"
                                                                   MinWidth="130" Margin="12,0" />

                                                        <TextBlock Grid.Column="2" Text="{Binding DateLabel}"
                                                                   Style="{StaticResource SsCaptionText}"
                                                                   VerticalAlignment="Center"
                                                                   MinWidth="86" TextAlignment="Right"
                                                                   Margin="0,0,12,0" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ==================== Durum ==================== -->
        <Border Grid.Row="3" Style="{StaticResource SsCard}" Margin="0,16,0,0"
                Background="{DynamicResource SsSurfaceRaised}"
                Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}">
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource SsBodyText}" />
        </Border>
      </Grid>

      <!-- ==================== İşlem örtüsü ==================== -->
      <Grid Background="{DynamicResource SsScrim}"
            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
          <Border Style="{StaticResource SsCard}" Padding="40,36" MinWidth="380"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  Effect="{StaticResource SsShadowHigh}">
              <StackPanel HorizontalAlignment="Center">
                  <!-- Süre öngörülemediği için belirsiz halka: sahte yüzde göstermiyoruz. -->
                  <controls:ScanRing Width="120" Height="120" Thickness="10"
                                     IsIndeterminate="True"
                                     TrackBrush="{DynamicResource SsSurfaceHover}"
                                     ProgressBrush="{DynamicResource SsAccentGradient}" />

                  <TextBlock Text="{Binding BusyTitle}" Style="{StaticResource SsTitleText}"
                             HorizontalAlignment="Center" Margin="0,22,0,0" />

                  <TextBlock Text="{Binding BusyDetail}" Style="{StaticResource SsSecondaryText}"
                             HorizontalAlignment="Center" TextAlignment="Center"
                             MaxWidth="320" Margin="0,6,0,0" />

                  <Button Content="İptal" Style="{StaticResource SsSecondaryButton}"
                          Command="{Binding CancelCommand}" HorizontalAlignment="Center"
                          MinWidth="120" Margin="0,22,0,0" />
              </StackPanel>
          </Border>
      </Grid>
    </Grid>

</UserControl>

<UserControl x:Class="SysScrub.App.Views.Pages.DriversPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SysScrub.App.Converters"
             xmlns:loc="clr-namespace:SysScrub.App.Localization"
             xmlns:controls="clr-namespace:SysScrub.App.Controls"
             xmlns:vm="clr-namespace:SysScrub.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:DriversViewModel}">

    <UserControl.Resources>
        <conv:GeometryKeyConverter x:Key="GeometryKey" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:StringToVisibilityConverter x:Key="StringToVisibility" />

        <!-- Sürücü satırı: kategori + cihaz solda, kurulu ve kullanılabilir sürüm sağda -->
        <DataTemplate x:Key="DriverRowTemplate" DataType="{x:Type vm:DriverRowViewModel}">
            <Border Padding="14,12" Margin="0,0,0,6"
                    CornerRadius="{StaticResource SsRadiusControl}"
                    Background="{DynamicResource SsSurfaceRaised}"
                    BorderBrush="{DynamicResource SsBorder}"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}"
                              VerticalAlignment="Center" Margin="0,0,12,0"
                              IsEnabled="{Binding HasUpdate}" />

                    <Border Grid.Column="1" Width="38" Height="38" Margin="0,0,14,0"
                            CornerRadius="{StaticResource SsRadiusSmall}"
                            Background="{DynamicResource SsSurfaceHover}">
                        <Path Data="{Binding IconKey, Converter={StaticResource GeometryKey}}"
                              Fill="{DynamicResource SsTextSecondary}"
                              Stretch="Uniform" Width="19" Height="19"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <!-- Kategori + cihaz adı -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding CategoryName}"
                                       Style="{StaticResource SsBodyText}"
                                       FontWeight="SemiBold" />

                            <Border Style="{StaticResource SsBadge}" Margin="8,0,0,0" Padding="7,1"
                                    Background="{DynamicResource SsAccentTint}"
                                    Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding StatusLabel}" FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SsAccentText}" />
                            </Border>

                            <Border Style="{StaticResource SsBadge}" Margin="8,0,0,0" Padding="7,1"
                                    Background="{DynamicResource SsCautionTint}"
                                    Visibility="{Binding IsPossiblyOutdated, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding AgeLabel}" FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SsCaution}" />
                            </Border>
                        </StackPanel>

                        <TextBlock Text="{Binding DeviceName}"
                                   Style="{StaticResource SsCaptionText}"
                                   Margin="0,3,12,0"
                                   TextTrimming="CharacterEllipsis" />

                        <TextBlock Text="{Binding ProblemDescription}"
                                   Style="{StaticResource SsCaptionText}"
                                   Foreground="{DynamicResource SsDanger}"
                                   Margin="0,2,0,0"
                                   Visibility="{Binding HasProblem, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>

                    <!-- Kurulu / kullanılabilir -->
                    <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="16,0,20,0" MinWidth="230">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{loc:Str Dr_Installed}" Style="{StaticResource SsCaptionText}" />
                            <TextBlock Text="{Binding InstalledLabel}" Style="{StaticResource SsMonoText}"
                                       FontSize="11.5" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0"
                                    ToolTip="{Binding AvailableTooltip}">
                            <TextBlock Text="{loc:Str Dr_Available}" Style="{StaticResource SsCaptionText}" />
                            <TextBlock Text="{Binding AvailableLabel}" FontSize="11.5">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SsMonoText}">
                                        <Style.Triggers>
                                            <!-- Kesin güncelleme vurgu renginde; belirsiz olan sessiz kalır. -->
                                            <DataTrigger Binding="{Binding HasUpdate}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource SsAccentText}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Column="4" Content="{loc:Str Dr_Update}"
                            Style="{StaticResource SsSecondaryButton}"
                            MinWidth="96" VerticalAlignment="Center"
                            IsEnabled="{Binding HasUpdate}"
                            ToolTip="{loc:Str Dr_UpdateTip}" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
      <Grid Margin="{StaticResource SsPagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ==================== Başlık ==================== -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="{loc:Str Nav_Drivers}" Style="{StaticResource SsDisplayText}" />
            <TextBlock Style="{StaticResource SsSecondaryText}" Margin="0,6,0,0"
                       Text="{loc:Str Dr_Subtitle}" />
        </StackPanel>

        <!-- ==================== Özet şeridi ==================== -->
        <Border Grid.Row="1" Style="{StaticResource SsCard}" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="44" Height="44" Margin="0,0,16,0"
                        CornerRadius="{StaticResource SsRadiusControl}"
                        Background="{DynamicResource SsAccentTint}">
                    <Path Data="{StaticResource IconDrivers}" Fill="{DynamicResource SsAccent}"
                          Stretch="Uniform" Width="22" Height="22"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding HeadlineText}" Style="{StaticResource SsTitleText}" />
                    <TextBlock Text="{Binding HeadlineDetail}" Style="{StaticResource SsCaptionText}"
                               Margin="0,3,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="{loc:Str Dr_Backup}"
                            Style="{StaticResource SsSubtleButton}"
                            Command="{Binding BackupCommand}"
                            ToolTip="{loc:Str Dr_BackupTip}"
                            Margin="0,0,8,0" />

                    <Button Content="{loc:Str Dr_ReadHardware}"
                            Style="{StaticResource SsSecondaryButton}"
                            Command="{Binding LoadCommand}"
                            Margin="0,0,8,0" MinWidth="126" />

                    <Button Content="{loc:Str Dr_UpdateNow}"
                            Style="{StaticResource SsPrimaryButton}"
                            Command="{Binding CheckUpdatesCommand}"
                            MinWidth="150" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== Liste ==================== -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Windows Update sonucu -->
                <Border Style="{StaticResource SsCard}" Margin="0,0,0,12"
                        Background="{DynamicResource SsSurfaceRaised}"
                        Visibility="{Binding SourceMessage, Converter={StaticResource StringToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource SsIcon}" Data="{StaticResource IconStatusInfo}"
                              Fill="{DynamicResource SsInfo}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding SourceMessage}" Style="{StaticResource SsBodyText}"
                                   Margin="12,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Dikkat isteyenler -->
                <StackPanel Visibility="{Binding HasAttention, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel Margin="2,0,2,10">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="{loc:Str Btn_SelectAll}" Style="{StaticResource SsSubtleButton}"
                                    Command="{Binding SelectAllCommand}" MinHeight="26" Padding="9,0" FontSize="11.5" />
                            <Button Content="{loc:Str Btn_SelectNone}" Style="{StaticResource SsSubtleButton}"
                                    Command="{Binding SelectNoneCommand}" MinHeight="26" Padding="9,0" FontSize="11.5" />
                        </StackPanel>

                        <TextBlock Text="{Binding AttentionHeader}" Style="{StaticResource SsSectionLabel}"
                                   VerticalAlignment="Center" />
                    </DockPanel>

                    <ItemsControl ItemsSource="{Binding Attention}"
                                  ItemTemplate="{StaticResource DriverRowTemplate}" />
                </StackPanel>

                <!-- Güncel olanlar: katlanmış -->
                <Border Style="{StaticResource SsCard}" Padding="0" Margin="0,10,0,0"
                        Visibility="{Binding HasLoaded, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <Button Style="{StaticResource SsSubtleButton}"
                                Command="{Binding ToggleUpToDateCommand}"
                                HorizontalContentAlignment="Left"
                                HorizontalAlignment="Stretch"
                                MinHeight="44" Padding="20,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconStatusGood}" Fill="{DynamicResource SsGood}"
                                      Stretch="Uniform" Width="16" Height="16" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding UpToDateHeader}" Margin="10,0,0,0"
                                           VerticalAlignment="Center" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>

                        <ItemsControl ItemsSource="{Binding UpToDate}"
                                      ItemTemplate="{StaticResource DriverRowTemplate}"
                                      Margin="14,0,14,14"
                                      Visibility="{Binding ShowUpToDate, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ==================== Durum ==================== -->
        <Border Grid.Row="3" Style="{StaticResource SsCard}" Margin="0,14,0,0"
                Background="{DynamicResource SsSurfaceRaised}"
                Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}">
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource SsBodyText}" />
        </Border>
      </Grid>

      <!-- ==================== İşlem örtüsü ==================== -->
      <Grid Background="{DynamicResource SsScrim}"
            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
          <Border Style="{StaticResource SsCard}" Padding="40,36" MinWidth="380"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  Effect="{StaticResource SsShadowHigh}">
              <StackPanel HorizontalAlignment="Center">
                  <!-- Süre öngörülemediği için belirsiz halka: sahte yüzde göstermiyoruz. -->
                  <controls:ScanRing Width="120" Height="120" Thickness="10"
                                     IsIndeterminate="True"
                                     TrackBrush="{DynamicResource SsSurfaceHover}"
                                     ProgressBrush="{DynamicResource SsAccentGradient}" />

                  <TextBlock Text="{Binding BusyTitle}" Style="{StaticResource SsTitleText}"
                             HorizontalAlignment="Center" Margin="0,22,0,0" />

                  <TextBlock Text="{Binding BusyDetail}" Style="{StaticResource SsSecondaryText}"
                             HorizontalAlignment="Center" TextAlignment="Center"
                             MaxWidth="320" Margin="0,6,0,0" />

                  <Button Content="{loc:Str Btn_Cancel}" Style="{StaticResource SsSecondaryButton}"
                          Command="{Binding CancelCommand}" HorizontalAlignment="Center"
                          MinWidth="120" Margin="0,22,0,0" />
              </StackPanel>
          </Border>
      </Grid>
    </Grid>

</UserControl>

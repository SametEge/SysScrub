<UserControl x:Class="SysScrub.App.Views.Pages.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SysScrub.App.Controls"
             xmlns:conv="clr-namespace:SysScrub.App.Converters"
             xmlns:vm="clr-namespace:SysScrub.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:DashboardViewModel}">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="{StaticResource SsPagePadding}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ==================== Başlık ==================== -->
            <StackPanel Grid.Row="0" Margin="0,0,0,24">
                <TextBlock Text="Panel" Style="{StaticResource SsDisplayText}" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="{Binding OsLabel}" Style="{StaticResource SsSecondaryText}" />
                    <TextBlock Text="  ·  " Style="{StaticResource SsSecondaryText}" />
                    <TextBlock Text="{Binding MachineLabel}" Style="{StaticResource SsSecondaryText}" />
                    <TextBlock Text="  ·  " Style="{StaticResource SsSecondaryText}" />
                    <TextBlock Text="{Binding UptimeLabel}" Style="{StaticResource SsSecondaryText}" />
                </StackPanel>
            </StackPanel>

            <!-- ==================== Bento ızgara ==================== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.35*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <!-- Kalan yüksekliği disk listesi alır; sağ sütunda boşluk kalmasın. -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Tarama kartı — sayfanın ana eylemi -->
                <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" Style="{StaticResource SsCard}">
                    <StackPanel>
                        <TextBlock Text="TEMİZLİK" Style="{StaticResource SsSectionLabel}" />

                        <Grid Height="212" Margin="0,20,0,16">
                            <!-- Tarama sürerken gerçek ilerlemeyi gösterir, bitince tam tur olur. -->
                            <controls:ScanRing Width="200" Height="200"
                                               Thickness="16"
                                               Progress="{Binding ScanRingProgress, Mode=OneWay}"
                                               TrackBrush="{DynamicResource SsSurfaceHover}"
                                               ProgressBrush="{DynamicResource SsAccentGradient}" />

                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding ScanValueLabel}"
                                           Style="{StaticResource SsMetricValue}"
                                           FontSize="36"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding ScanCaption}"
                                           Style="{StaticResource SsCaptionText}"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           MaxWidth="150"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Style="{StaticResource SsSecondaryText}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   Margin="8,0,8,18"
                                   Text="{Binding ScanHint}" />

                        <!-- Taranmadan önce: tek eylem, taramayı başlat -->
                        <Button Content="Taramayı başlat"
                                Style="{StaticResource SsPrimaryButton}"
                                MinHeight="{StaticResource SsControlHeightLarge}"
                                Command="{Binding Cleaner.ScanCommand}"
                                Visibility="{Binding HasScanned, Converter={StaticResource InverseBoolToVisibility}}" />

                        <!-- Tarandıktan sonra: incelemeye geç, istersen yeniden tara -->
                        <StackPanel Visibility="{Binding HasScanned, Converter={StaticResource BoolToVisibility}}">
                            <Button Content="Temizleyiciyi aç"
                                    Style="{StaticResource SsPrimaryButton}"
                                    MinHeight="{StaticResource SsControlHeightLarge}"
                                    Command="{Binding OpenCleanerCommand}" />

                            <Button Content="Yeniden tara"
                                    Style="{StaticResource SsSubtleButton}"
                                    Margin="0,8,0,0"
                                    Command="{Binding Cleaner.ScanCommand}" />
                        </StackPanel>

                        <TextBlock Text="{Binding Cleaner.ProgressLabel}"
                                   Style="{StaticResource SsCaptionText}"
                                   HorizontalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="240"
                                   Margin="0,10,0,0"
                                   Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Border>

                <!-- Sistem diski -->
                <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource SsCard}">
                    <StackPanel>
                        <DockPanel>
                            <Border DockPanel.Dock="Right"
                                    Style="{StaticResource SsBadge}"
                                    Background="{DynamicResource SsAccentTint}">
                                <TextBlock Text="{Binding SystemDriveName}"
                                           Foreground="{DynamicResource SsAccentText}"
                                           FontSize="11"
                                           FontWeight="SemiBold" />
                            </Border>
                            <TextBlock Text="SİSTEM DİSKİ" Style="{StaticResource SsSectionLabel}" />
                        </DockPanel>

                        <TextBlock Text="{Binding SystemDriveFree}"
                                   Style="{StaticResource SsMetricValue}"
                                   Margin="0,14,0,0" />
                        <TextBlock Text="boş alan" Style="{StaticResource SsCaptionText}" />

                        <ProgressBar Value="{Binding SystemDriveUsedRatio, Mode=OneWay}"
                                     Maximum="1"
                                     Height="6"
                                     Margin="0,16,0,8"
                                     Background="{DynamicResource SsSurfaceHover}"
                                     Foreground="{DynamicResource SsAccent}"
                                     BorderThickness="0" />

                        <TextBlock Text="{Binding SystemDriveDetail}" Style="{StaticResource SsCaptionText}" />
                    </StackPanel>
                </Border>

                <!-- Bellek -->
                <Border Grid.Row="0" Grid.Column="4" Style="{StaticResource SsCard}">
                    <StackPanel>
                        <TextBlock Text="BELLEK" Style="{StaticResource SsSectionLabel}" />

                        <TextBlock Text="{Binding MemoryLabel}"
                                   Style="{StaticResource SsMetricValue}"
                                   Margin="0,14,0,0" />
                        <TextBlock Text="kullanımda" Style="{StaticResource SsCaptionText}" />

                        <ProgressBar Value="{Binding MemoryUsedRatio, Mode=OneWay}"
                                     Maximum="1"
                                     Height="6"
                                     Margin="0,16,0,8"
                                     Background="{DynamicResource SsSurfaceHover}"
                                     Foreground="{DynamicResource SsAccent}"
                                     BorderThickness="0" />

                        <TextBlock Text="{Binding MemoryDetail}" Style="{StaticResource SsCaptionText}" />
                    </StackPanel>
                </Border>

                <!-- Sürücüler listesi -->
                <Border Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="3" Style="{StaticResource SsCard}">
                    <StackPanel>
                        <TextBlock Text="DİSKLER" Style="{StaticResource SsSectionLabel}" Margin="0,0,0,12" />

                        <ItemsControl ItemsSource="{Binding Drives}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:DriveRow}">
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0"
                                                   Text="{Binding Name}"
                                                   Style="{StaticResource SsSubtitleText}"
                                                   VerticalAlignment="Center" />

                                        <TextBlock Grid.Row="0" Grid.Column="1"
                                                   Text="{Binding Label}"
                                                   Style="{StaticResource SsBodyText}"
                                                   VerticalAlignment="Center" />

                                        <TextBlock Grid.Row="0" Grid.Column="2"
                                                   Text="{Binding Detail}"
                                                   Style="{StaticResource SsCaptionText}"
                                                   VerticalAlignment="Center" />

                                        <ProgressBar Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                                     Value="{Binding UsedRatio, Mode=OneWay}"
                                                     Maximum="1"
                                                     Height="5"
                                                     Margin="0,8,0,0"
                                                     Background="{DynamicResource SsSurfaceHover}"
                                                     Foreground="{DynamicResource SsAccent}"
                                                     BorderThickness="0">
                                            <ProgressBar.Style>
                                                <Style TargetType="ProgressBar">
                                                    <Style.Triggers>
                                                        <!-- %90 üstü doluluk uyarı rengine geçer: bu bir durum, eylem değil. -->
                                                        <DataTrigger Binding="{Binding IsCriticallyFull}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource SsCaution}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ProgressBar.Style>
                                        </ProgressBar>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!--
                Yetki uyarısı yalnızca eksik olduğunda görünür. Uygulama normalde
                yönetici olarak açılır (manifest); bu şerit dev senaryosu ya da
                yükseltmenin atlandığı durumlar için, ve bilgi değil eylem sunar.
            -->
            <Border Grid.Row="2" Style="{StaticResource SsCard}" Margin="0,16,0,0"
                    Background="{DynamicResource SsCautionTint}"
                    BorderBrush="{DynamicResource SsCaution}"
                    Visibility="{Binding ShowElevationWarning, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Path Grid.Column="0"
                          Style="{StaticResource SsIcon}"
                          Data="{StaticResource IconStatusCaution}"
                          Fill="{DynamicResource SsCaution}"
                          VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1" Margin="12,0,16,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource SsBodyText}"
                                   FontWeight="SemiBold"
                                   Text="Yönetici hakkı olmadan çalışıyor" />
                        <TextBlock Style="{StaticResource SsCaptionText}"
                                   Margin="0,2,0,0"
                                   Text="Windows Update önbelleği, sistem geçici dosyaları ve sürücü işlemleri bu hakkı ister — bunlar genelde en çok yer kazandıranlar." />
                    </StackPanel>

                    <Button Grid.Column="2"
                            Content="Yönetici olarak yeniden başlat"
                            Style="{StaticResource SsSecondaryButton}"
                            VerticalAlignment="Center"
                            Command="{Binding RestartElevatedCommand}"
                            Visibility="{Binding CanRestartElevated, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>

</UserControl>

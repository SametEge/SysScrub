<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>SysScrub.App</RootNamespace>
    <!-- Çıktı adı bilerek SysScrub.exe: dist/ ve kurulum paketi bu adı bekliyor. -->
    <AssemblyName>SysScrub</AssemblyName>
    <ApplicationIcon>Assets\SysScrub.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
  </PropertyGroup>

  <ItemGroup>
    <ApplicationDefinition Include="App.xaml" SubType="Designer" Generator="MSBuild:Compile" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SysScrub.Core\SysScrub.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\SysScrub.ico" />
  </ItemGroup>

  <!--
    Çeviri katalogları veri olarak duruyor: bir dile katkı vermek tek JSON dosyası
    göndermek demek, kod değişikliği değil. Derlemeye gömülüyorlar ki tek dosya
    yayınında da yanlarında taşınsınlar.
  -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\data\i18n\*.json" LogicalName="SysScrub.App.Localization.%(Filename).json" />
  </ItemGroup>

</Project>

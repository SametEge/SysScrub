<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>SysScrub.Core</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Motor katmanı: hiçbir UI bağımlılığı yok, CLI ve WPF tarafından ortak kullanılır. -->
    <UseWPF>false</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.1" />
  </ItemGroup>

  <!--
    Temizleme kuralları koda gömülü değil, veri. Derlemeye kaynak olarak eklenir ki
    tek dosya yayınında da yanlarında taşınsınlar; kullanıcı isterse aynı kimlikli
    kuralı %ProgramData%\SysScrub\rules altında ezebilir.
  -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\data\rules\*.json" LogicalName="SysScrub.Core.Rules.Definitions.%(Filename).json" />
  </ItemGroup>

</Project>
